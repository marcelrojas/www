{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "send_metrics": false,
  "main": "./worker.js",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "marcelrojas.net", "custom_domain": true },
    { "pattern": "www.marcelrojas.net", "custom_domain": true },
    { "pattern": "media.marcelrojas.net", "custom_domain": true },
    { "pattern": "sound.marcelrojas.net", "custom_domain": true },
    { "pattern": "cv.marcelrojas.net", "custom_domain": true }
  ],
  "compatibility_flags": [ "nodejs_compat", "global_fetch_strictly_public" ]
}