---
import Layout from '@layouts/Layout.astro';
import Anchor from '@components/Anchor.astro';
import PageHeader from '@components/structure/PageHeader.astro';

const {
  title = 'Sound',
  screen_title = 'Sound',
  description = 'Marcel Rojas as a musician and composer — releases, sound work, and where to listen.',
} = Astro.props;
---

<Layout title={title} description={description}>
  <PageHeader screen_title={screen_title} />

  <section class="showcase">
    <h2>Featured Tracks</h2>
  </section>
</Layout>

