---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/structure/PageHeader.astro';
import FAQItem from '@components/FAQItem.astro';
import Anchor from '@components/Anchor.astro';
import {
  SITE_TITLE,
  EMAIL,
  BOOKING_CAL,
  SOCIAL_CONTRA,
} from '@src/types/consts';

const {
  encEmail = EMAIL,
  screen_title = 'Services',
  description = 'Multidisciplinary consulting and execution across Web & Software Development, UI/UX & Design Systems, Computer Science, Hardware & Network Engineering, Audio Production, and Business Administration.',
} = Astro.props;

const faqs = [
  {
    question: 'How can one professional cover software, hardware, audio, and business administration?',
    answer: 'Every discipline I practice reinforces the others: my computer science and electronics background lets me debug from physical circuits and TCP/IP packets up to Astro/React frontends, while my formal training in Business Administration (UPTJAA) ensures every technical decision aligns with budgets, inventories, and real operational workflows.',
  },
  {
    question: 'How do we start a project and what is your typical process?',
    answer: 'We start with a focused discovery session or asynchronous brief to define your objectives, constraints, and timeline. Within 24–48 hours, you receive a clear scope proposal with milestones and fixed or retainer pricing. Execution runs with transparent updates via GitHub, Linear/Notion, or your team’s preferred channel.',
  },
  {
    question: 'Which services are available remotely vs. on-site?',
    answer: 'All software engineering, UI/UX design systems, audio production, technical writing, and administrative/spreadsheet consulting are available 100% remotely worldwide. Physical hardware diagnostics, FTTH/LAN cabling, and on-site organizational audits are available across Barcelona, Lechería, Puerto La Cruz, and Guanta (Anzoátegui, Venezuela).',
  },
  {
    question: 'How do payments and contracts work?',
    answer: 'International clients can hire me commission-free with milestone escrow protection through Contra, or pay via international transfer, PayPal, Wally, or Binance. Local businesses in Venezuela can también pay via invoice in USD or Bolívares (BNC / Banesco / Pago Móvil).',
  },
  {
    question: 'Can you integrate with an existing engineering, design, or operations team?',
    answer: 'Yes. I regularly collaborate with product squads, agencies, and company directors—adopting your Git workflows (pnpm, TypeScript, PR reviews), Figma token libraries, or internal ERP/spreadsheet systems.',
  },
];
---

<Layout title={`${screen_title} — ${SITE_TITLE}`} description={description}>
  <PageHeader screen_title={screen_title} />

  <section aria-labelledby="services-heading">
    <div class="content">
      <h2 id="services-heading">Overview of services offered</h2>

      <div class="collection-panel">
        <article class="panel">
          <h3>Strategy</h3>
          <div class="content">
            <ul>
              <li>Visual Research</li>
              <li>Competitive Analysis</li>
              <li>Wireframes</li>
              <li>Content Mapping</li>
              <li>User Flow</li>
             <li>Concepts</li>
            </ul>
          </div>
        </article>

        <article class="panel">
          <h3>Design</h3>
          <div class="content">
            <ul>
              <li>Web Design</li>
              <li>UI/UX Design</li>
              <li>Design System</li>
              <li>Motion Design</li>
              <li>Prototyping</li>
              <li>Accessible Design</li>
            </ul>
          </div>
        </article>

        <article class="panel">
          <h3>Development</h3>
          <div class="content">
            <ul>
              <li>Web Development</li>
              <li>Web Animation</li>
              <li>CMS Integration</li>
              <li>Accessible Development</li>
              <li>Technical SEO and GEO/AEO</li>
              <li>Native Android App and Progressive Web App Development</li>
            </ul>
          </div>
        </article>
      </div>

      <div class="footer">
        <Anchor href="">Get in touch</Anchor>
      </div>
    </div>
  </section>

  <section id="section-pricing" aria-labelledby="pricing-heading">
    <h2 id="pricing-heading" class="headline">Engagement Models &amp; Pricing</h2>

    <div class="cards">
      <article class="card">
        <span class="tier-tag">Focused Sprint</span>
        <h3 class="headline">Starter Package — From $150</h3>
        <p>Ideal for landing pages, UI/UX or accessibility audits, custom Excel/Sheets models, Linux/network setups, or single-module deliverables.</p>
        <Anchor wide="fill" href={SOCIAL_CONTRA}>
          Order on Contra →
        </Anchor>
      </article>

      <article class="card">
        <span class="tier-tag">Bespoke Project</span>
        <h3 class="headline">End-to-End Build — Custom Quote</h3>
        <p>Full design systems, multi-page JAMstack sites, mobile apps, custom audio tooling, or organizational manuals (MOF) and process audits.</p>
        <Anchor
          wide="fill"
          href={`mailto:${EMAIL}?subject=Project%20Inquiry%20—%20marcelrojas.net`}
        >Request a detailed quote →</Anchor>
      </article>

      <article class="card">
        <span class="tier-tag">Dedicated Partner</span>
        <h3 class="headline">For a Squad or Company</h3>
        <p>Ongoing fractional Design Engineering, systems/IT administration, or operational consulting integrated directly with your team.</p>
        <Anchor wide="fill" href={BOOKING_CAL}>Book a discovery call →</Anchor>
      </article>
    </div>

    <div class="footer">
      <div class="payment-info">
        <span>
          Escrow &amp; milestone payments secured via{' '}
          <Anchor href={SOCIAL_CONTRA}>
            Contra
          </Anchor>{' '}
          or direct invoice (<Anchor href={`mailto:${EMAIL}`}>{EMAIL}</Anchor>).
        </span>
      </div>
    </div>
  </section>

  <section id="section-faq" aria-labelledby="faq-heading">
    <div class="content">
      <h2 id="faq-heading" class="headline">How I Work — Frequently Asked Questions</h2>
      <ul>
        {faqs.map((faq) => (
          <li>
            <FAQItem question={faq.question} answer={faq.answer} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .services-section,
  section#section-pricing,
  section#section-faq {
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 40px;
    padding-block: 48px;
  }

  .collection-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }

  .panel {
    padding: 28px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;

    & .panel-title {
      margin: 0;
      font-size: var(--font-size-20);
    }

    & .panel-summary {
      margin: 0;
      font-size: var(--font-size-14);
      opacity: 0.8;
    }

    & ul {
      margin: 0;
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: var(--font-size-14);
    }
  }

  section#section-pricing .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    width: 100%;
    margin-block: 28px;
  }

  section#section-pricing .card {
    padding: 28px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }

  .tier-tag {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-12);
    text-transform: uppercase;
    opacity: 0.7;
  }


  
  section#section-pricing {
    align-items: center;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 20px;
    height: min-content;
    justify-content: center;
    overflow: hidden;
    padding: 30px;
    position: relative;
    width: 100%;
    will-change: transform;

    & h2.headline {
      align-items: flex-start;
      display: flex;
      flex: none;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 20px;
      justify-content: flex-start;
      position: relative;
    }

    & div.cards {
      align-items: center;
      display: flex;
      flex: none;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 10px;
      height: min-content;
      justify-content: center;
      overflow: hidden;
      position: relative;
      width: 100%;

      & article.card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        background-color: oklch(96.416% 0.00011 271.152);
        flex: 1 0 0px;
        height: 230px;
        position: relative;

        & h3 {
          font-size: 1.5rem;
          margin-bottom: 1rem;
        }

        & a {
          font-size: 16px;
          height: 50px;
        }
      }
    }

    & > div.footer {
      flex-flow: column;
      flex: none;
      align-items: flex-start;
      gap: 4px;
      justify-content: center;
      position: relative;
      width: 100%;
    }
  }



  section#section-services {
    & div.content {
      max-width: 1200px;

      & h2.headline {
        font-size: 2rem;
      }

      & p.subhead {
        font-size: 1.25rem;
        margin-top: 8px;
      }

      & div.collection-panel {
        padding-top: 96px;
        padding-bottom: 96px;
        position: relative;
        justify-content: center;
        align-items: center;
        display: flex;
        contain: style;

        & article.panel {
          width: 23.875em;
          position: relative;
          aspect-ratio: 382/528;

          & h3 {
            font-size: 1.5rem;
            margin-bottom: 16px;
          }
        }
      }
    }

    & div.footer {
      padding-bottom: 64px;
      place-content: center;
      display: flex;
    }
  }



  section#section-faq {
    padding-block: var(--spacing-13);

    & > div.content {
      max-width: 980px;
      padding-inline-start: calc(var(--spacing-sal) + 22px);
      padding-inline-end: calc(var(--spacing-sar) + 22px);
      margin-left: auto;
      margin-right: auto;

      & > h2.headline {
        font-size: var(--font-size-32);
        font-weight: var(--font-weight-bold);
        line-height: 120%;
        color: oklch(0.17 0 0 / 0.9);
        text-align: center;
      }

      & > p.subhead {
        font-size: var(--font-size-18);
        font-weight: var(--font-weight-medium);
        line-height: 140%;
        color: oklch(0.17 0 0 / 0.7);
        text-align: center;
      }

      & > ul {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-04);
      }
    }
  }
</style>