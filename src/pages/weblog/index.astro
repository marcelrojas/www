---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/structure/PageHeader.astro';
import Anchor from '@components/Anchor.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Pagination from '@components/Pagination.astro';
import featured from '@data/featured.json';

const posts = (await getCollection('weblog')).map(post => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate,
  href: `/weblog/${post.id}`,
  external: false,
}));

const external = Object.values(featured).map(item => ({
  title: item.title,
  description: `Published by ${item.publisher}`,
  date: new Date(item.pubDate),
  href: item.url,
  external: true,
}));

const timeline = [...posts, ...external].sort((a, b) => b.date - a.date);
const byYear = Object.groupBy(timeline, item => item.date.getFullYear());

const {
  title = 'Weblog',
  screen_title = 'Weblog',
  description = 'Thoughts on code, design, audio engineering, and everything I\'m passionate about — my own writing, plus features published elsewhere.',
} = Astro.props;
---

<Layout title={title} description={description}>
  <PageHeader screen_title={screen_title} />

  <section id="post-list" role="feed" aria-busy="false" aria-label="List of blog articles">
    <div class="content">

      <p>{description}</p>
      
      {Object.entries(byYear).map(([year, items]) => (
        <section aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          
          {items.map(item => (
            <article class="post-item">
              <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
                <h3>{item.title}</h3>
                {item.description && <p class="summary">{item.description}</p>}
                <FormattedDate date={item.date} />
                {item.external && <span class="badge">Externo</span>}
              </a>
            </article>
          ))}
        </section>
      ))}
      
    </div>

    <figure class="event">
      <picture>
        <img src="" alt="" />
      </picture>
      <figcaption>
        <img src="" aria-hidden="true" />
        <div class="">
          <h3>THE RAMP is OUT NOW!</h3>
          <date>Tue, August 3, 2021 9:05 AM PDT</date>
        </div>
      </figcaption>
    </figure>
    
  </section>
</Layout>

<style is:global>
  section#post-list {
    position: relative;
    padding-top: var(--spacing-11);
    padding-bottom: var(--spacing-11);

    & > div.content {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-03);
      max-width: 980px;
      padding-inline-start: calc(var(--spacing-sal) + var(--spacing-06));
      padding-inline-end: calc(var(--spacing-sar) + var(--spacing-06));
      margin-left: auto;
      margin-right: auto;
      overflow-wrap: break-word;
      text-wrap: pretty;
      
      & > p {
        
      }
      
      & > section {
        
        
        & > h2 {
          
        }
        
        & > article.post-item {
          position: relative;
          overflow: hidden;
          user-select: none;
          will-change: transform;
          
          @starting-style {
            opacity: 0;
            transform: translateY(20px);
          }
          
          &:focus-visible {
            outline: 2px solid var(--color-focus);
            outline-offset: 2px;
          }
          
          & > a {
            color: inherit;
            display: block;
            padding: var(--spacing-06);
            
            &:visited {
              color: var(--accent-visited);
            }
            
            & > h3 {
              max-width: 300px;
              margin-bottom: var(--spacing-03);
              font-family: var(--font-family-sans);
              font-weight: var(--font-weight-medium);
              font-size: var(--font-size-18);
              line-height: 1;
              line-clamp: 3;
              box-orient: vertical;
              color: var(--label-primary);
            }
            
            & > p.summary {
              margin-top: var(--spacing-02);
              margin-bottom: var(--spacing-04);
              max-width: 300px;
              font-family: var(--font-family-sans);
              font-weight: var(--font-weight-medium);
              font-size: var(--font-size-14);
              line-height: var(--line-height-24);
              line-clamp: 3;
              box-orient: vertical;
              color: var(--label-secondary);
            }
            
            & > cite.publisher {
              margin-top: var(--spacing-04);
              font-family: var(--font-family-sans);
              font-weight: var(--font-weight-medium);
              font-size: var(--font-size-12);
              line-height: var(--font-leading-tight);
              line-clamp: 1;
              color: var(--color-label-secondary)
            }
          }
        }
      }

      & > :first-child { grid-area: a; }
      & > :nth-child(2) { grid-area: b; }
      & > :nth-child(3) { grid-area: c; }
      & > :nth-child(4) { grid-area: d; }
      & > :nth-child(5) { grid-area: e; }
    }
  }
</style>