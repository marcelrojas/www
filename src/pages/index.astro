---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/structure/PageHeader.astro';
import Anchor from '@components/Anchor.astro';
import Button from '@components/Button.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKEDIN } from '@src/types/consts';

const {
  title = 'About',
  screen_title = 'About',
} = Astro.props;
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <PageHeader screen_title={screen_title} />

  <section class="intro-section">
    <h2 class="sr-only">About Me</h2>
    <div aria-label="My purpose">
      <p>
        <span aria-hidden="true" class="sr-only">To ship apps and websites</span>
        <span aria-hidden="true">.</span>
        <span class="sr-only">.</span>
      </p>
      <div class="actions">
        <Anchor size="small" href="https://tally.com/marcelrojas/" target="_blank" rel="noopener noreferrer" class="badge audio_trigger">Fill form</Anchor>
        <Anchor size="small" href="https://contra.com/marcelrojas" target="_blank" rel="noopener noreferrer" class="badge audio_trigger">Explore my services on Contra</Anchor>
        <Button as="button" wide="fit" command="show-modal" commandfor="cvDialog" class="audio_trigger">Review full CV</Button>
      </div>
    </div>

    <div>
      <nav aria-label="My capabilities">
        <div>
          <span>
            <span></span>
            <span aria-hidden="true">.</span>
          </span>
        </div>

        <div>
          <span>
            <span></span>
            <span aria-hidden="true">.</span>
          </span>
        </div>

        <div>
          <span>
            <span></span>
            <span aria-hidden="true">.</span>
          </span>
        </div>

        <Anchor size="medium" href="/services">Know them all</Anchor>
      </nav>
    </div>
  </section>

  <dialog id="cvDialog" aria-labelledby="cv-name" aria-describedby="cv-role">
    <article class="cv-container">
      <header class="cv-header">
        <h3 id="cv-name">Marcel Rojas</h3>
        <p id="cv-role" class="role">Web Developer, UI/UX Designer, Administrator, OpenSource Maker</p>
        <address class="contact-info">
          <span>Anzoátegui, Venezuela</span> • <a href={SOCIAL_LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </address>
      </header>

      <div class="cv-body">
        <section>
          <h4>Profile</h4>
          <p>Multidisciplinary developer and designer focused on the JAMstack ecosystem, crafting performant, accessible, and highly interactive digital experiences. Experienced in component-driven architecture and technical writing.</p>
        </section>

        <section>
          <h4>Technical Expertise</h4>
          <ul class="skills-list">
            <li><strong>Core Languages:</strong> JavaScript, TypeScript, HTML, CSS, C++, Python, Rust.</li>
            <li><strong>Frameworks & Libraries:</strong> Astro, Svelte, React, Vue, Next.js, Nuxt, Tailwind CSS, shadcn/ui.</li>
            <li><strong>Platforms & Cloud:</strong> Vercel, Cloudflare, GitHub, Netlify, Node.js (Hono, Fastify).</li>
            <li><strong>Design & UI:</strong> Figma, Spline, Rive, Webflow, Framer.</li>
          </ul>
        </section>

        <section>
          <h4>Highlights & Contributions</h4>
          <ul class="experience-list">
            <li>
              <strong>Technical Writer — CSS-Tricks</strong>
              <p>Authored and published 3 technical articles focusing on modern frontend styling techniques and web development paradigms.</p>
            </li>
            <li>
              <strong>Freelance Developer — Contra</strong>
              <p>Designing and deploying tailored web applications, leveraging visual builders and code-based meta-frameworks for diverse clients.</p>
            </li>
          </ul>
        </section>
      </div>

      <footer class="cv-footer">
        <Anchor size="medium" href="/" target="_blank" rel="noopener noreferrer">Talk to Me</Anchor>
        <Button as="button" wide="fit" commandfor="cvDialog" command="close">Close CV</Button>
      </footer>
    </article>
  </dialog>

  <audio loop src="/audio/beats.aac" class="display-none"></audio>
</Layout>

<style>
  @layer page {
    section.intro-section {
      padding: 2rem 0;

      & .actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        align-items: center;
      }
    }

    dialog#cvDialog {
      width: 100%;
      max-width: 650px;

      &::backdrop {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px); 
      }

      & > article.cv-container {
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        max-height: 85vh;
        overflow-y: auto;

        & header.cv-header {
          padding-bottom: 1.5rem;

          & h3 {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.2;
          }

          p.role {
            font-size: 1.125rem;
            margin-top: 0.25rem;
            font-weight: 500;
          }

          address.contact-info {
            font-style: normal;
            font-size: 0.875rem;
            margin-top: 0.75rem;
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
          }
        }

        & .cv-body {
          display: flex;
          flex-direction: column;
          gap: 1.75rem;

          & h4 {
            font-size: 1.125rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
            padding-bottom: 0.25rem;
            display: inline-block;
          }

          & p {
            font-size: 0.95rem;
            line-height: 1.6;
          }
        }
      }
    }

    .skills-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.95rem;
    }

    .experience-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;

      & strong {
        display: block;
        font-size: 1rem;
        margin-bottom: 0.25rem;
      }
    }

    .cv-footer {
      display: flex;
      justify-content: flex-end;
      padding-top: 1rem;
    }


    article[class*="module-"] {

    }

    @media screen and (width <= 1024px) {

    }
  }
</style>
