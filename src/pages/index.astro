---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/structure/PageHeader.astro';
import Anchor from '@components/Anchor.astro';
import Button from '@components/Button.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_LINKEDIN } from '@src/types/consts';

const {
  title = 'About',
  screen_title = 'About',
} = Astro.props;
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <PageHeader screen_title={screen_title} />

  <section>
    <audio class="display-none" loop src="/audio/beats.aac"></audio>
    <div>
      <div aria-hidden="true">
        
      </div>
    </div>

    <div>
      <h2></h2>
      <p>
        <span aria-hidden="true" class="invisible">To ship apps and websites</span>
        <span aria-hidden="true"></span>
        <span class="sr-only">.</span>
      </p>
      <div>
        <Anchor label="text-only" size="small" href="https://tally.com/marcelrojas/" target="_blank" rel="noopener noreferrer" class="badge audio_trigger">Fill Form</Anchor>
        <Anchor label="text-only" size="small" href="https://contra.com/marcelrojas" target="_blank" rel="noopener noreferrer" class="badge audio_trigger">Talk to Me</Anchor>
        <Button as="button" wide="fit" class="audio_trigger" command="show-modal" commandfor="cvDialog">Review CV</Button>
      </div>
    </div>

    <div>
      <nav aria-label="My capabilities">
        <div>
          <span>
            <span></span>
            <span aria-hidden="true">.</span>
          </span>
        </div>

        <div>
          <span>
            <span></span>
            <span aria-hidden="true">.</span>
          </span>
        </div>

        <div>
          <span>
            <span></span>
            <span aria-hidden="true">.</span>
          </span>
        </div>
      </nav>
    </div>
  </section>

    <h2>Biography</h2>

      <dialog id="cvDialog">
        <span>Curriculum Vitae</span>
        <h3>Marcel Rojas</h3>

        <ul>
          <li>Explore my services on Contra</li>
          <li>
            <Anchor label="text-and-icon" size="small" href={SOCIAL_LINKEDIN} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</Anchor>
          </li>
        </ul>

        <Button as="button" wide="fit" commandfor="cvDialog" command="close">Close</Button>
      </dialog>

</Layout>

<style>
  @layer page {
    .collection-module {
      display: flex;
      flex-wrap: wrap;

      & > article[class*="module-"] {
        display: block;
        background-color: var(--background-secondary);

        & > h2.title {
          font-size: 32px;
          font-weight: var(--font-weight-medium);
          line-height: 40px;
        }

        & > p.description {
          padding-bottom: 18px;
          font-size: 14px;
          font-weight: 500;
          line-height: 24px;
          color: var(--text-secondary);
        }

        & > .badge {
          font-size: 14px;
        }
      }
    }

    @media screen and (width <= 1024px) {

      h2.title {
        line-height: 50px;
      }

      p.description {
        padding-bottom: 18px;
        font-size: 16px;
      }
    }
  }
</style>
