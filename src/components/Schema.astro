---
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_URL,
  SOCIAL_CONTRA,
  SOCIAL_GITHUB,
  SOCIAL_LINKEDIN,
  SOCIAL_TWITTER,
} from '@src/types/consts';
import { serializeJsonLd } from '@lib/jsonLD';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  lang?: 'en' | 'es';
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonicalURL = SITE_URL,
  lang = 'en',
} = Astro.props;

const inLanguage = lang === 'es' ? 'es-VE' : 'en-US';
const personDescription =
  lang === 'es'
    ? 'Ingeniero de Diseño, Desarrollador Full-Stack y de Sistemas, Técnico de Hardware y Redes, Productor de Audio y Administrador en Anzoátegui, Venezuela.'
    : SITE_DESCRIPTION;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#identity`,
      name: SITE_TITLE,
      alternateName: SITE_AUTHOR,
      url: SITE_URL,
      jobTitle: 'Design Engineer, Full-Stack & Systems Developer',
      description: personDescription,
      image: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/og.png`,
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Lechería',
        addressRegion: 'Anzoátegui',
        addressCountry: 'VE',
      },
      sameAs: [
        SOCIAL_TWITTER,
        SOCIAL_GITHUB,
        SOCIAL_LINKEDIN,
        SOCIAL_CONTRA,
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_TITLE,
      description: personDescription,
      publisher: {
        '@id': `${SITE_URL}/#identity`,
      },
      inLanguage: ['en-US', 'es-VE'],
      copyrightHolder: {
        '@id': `${SITE_URL}/#identity`,
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      isPartOf: {
        '@id': `${SITE_URL}/#website`,
      },
      about: {
        '@id': `${SITE_URL}/#identity`,
      },
      inLanguage,
    },
  ],
};

const schemaJson = serializeJsonLd(schemaData);
---

<script type="application/ld+json" set:html={schemaJson} />