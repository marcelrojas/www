---
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
---

<header id="header">
  <div class="content">
    <NavBar />

    <a class="wordmark">www.marcelrojas.net</a>

    <div class="gmt">
      <Clock />
    </div>
  </div>
</header>

<style is:global>
  @layer component {
    header#header {
      z-index: var(--z-header);
      padding-top: 36px;
      padding-left: calc(var(--spacing-sail) + 0px);
      padding-right: calc(var(--spacing-sair) + 0px);
      user-select: none;
      background-color: var(--sk-color-yellow-digital);
  
      & > div.content {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        justify-items: stretch;
        align-items: stretch;
        justify-content: space-between;
        grid-template-areas: "a a" "b c";
        padding-inline: 40px;
        height: 48px;

        & > a.wordmark {
          grid-area: a;
          width: stretch;
          display: inline-flex;
          align-self: center;
          font-family: var(--font-family-mono);
          font-feature-settings: "zero", "tnum";
          font-variant-numeric: tabular-nums;
          font-size: var(--font-size-12);
          font-weight: var(--font-weight-semibold);
          letter-spacing: var(--font-tracking-wide);
          line-height: var(--font-leading-normal);
          text-transform: uppercase;
          white-space: pre;
        }

        & > div.gmt {
          grid-area: b;
          display: flex;
          align-items: center;
          justify-content: flex-start;
          height: stretch;
          width: stretch;
        }
      }
    }
  }
</style>