---
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
import { LOCATION } from '@src/types/consts';
---

<header id="header">
  <div class="content">
    <a class="wordmark" href="/">www.marcelrojas.net</a>

    <dl class="stats" aria-label="Status">
      <div class="stat">
        <dt>Location</dt>
        <dd>{LOCATION}</dd>
      </div>
      <div class="stat">
        <dt>Local time</dt>
        <dd><Clock /></dd>
      </div>

      <!--
        Two more slots the reference layout leaves room for (a status
        line and a "site meta" readout, e.g. last updated / build info).
        Add them the same way once the copy is decided:

        <div class="stat">
          <dt>Status</dt>
          <dd>Open to new work</dd>
        </div>
        <div class="stat">
          <dt>Updated</dt>
          <dd>Aug 2026</dd>
        </div>
      -->
    </dl>

    <NavBar />
  </div>
</header>

<style is:global>
  @layer component {
    header#header {
      z-index: var(--z-header);
      padding-top: 36px;
      padding-left: calc(var(--spacing-sail) + 0px);
      padding-right: calc(var(--spacing-sair) + 0px);
      user-select: none;
      background-color: var(--sk-color-yellow-digital);

      & > div.content {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        column-gap: 32px;
        row-gap: 8px;
        padding-inline: 40px;
        padding-block: 12px;
        min-height: 48px;

        & > a.wordmark {
          display: inline-flex;
          align-items: center;
          font-family: var(--font-family-mono);
          font-feature-settings: "zero", "tnum";
          font-variant-numeric: tabular-nums;
          font-size: var(--font-size-12);
          font-weight: var(--font-weight-semibold);
          letter-spacing: var(--font-tracking-wide);
          line-height: var(--font-leading-normal);
          text-transform: uppercase;
          white-space: pre;
        }

        & > dl.stats {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          column-gap: 24px;
          row-gap: 4px;
          margin: 0;
          margin-inline-end: auto;

          & > div.stat {
            display: flex;
            align-items: baseline;
            gap: 6px;
            font-family: var(--font-family-mono);
            font-size: var(--font-size-12);
            letter-spacing: var(--font-tracking-wide);
            line-height: var(--font-leading-normal);
            text-transform: uppercase;
            white-space: pre;

            & > dt {
              opacity: 0.65;
              font-weight: var(--font-weight-regular);
            }

            & > dd {
              margin: 0;
              font-weight: var(--font-weight-semibold);
              font-variant-numeric: tabular-nums;
            }
          }
        }
      }

      @media screen and (width <= 860px) {
        & > div.content > dl.stats > div.stat:first-child {
          display: none;
        }
      }

      @media screen and (width <= 560px) {
        & > div.content {
          justify-content: center;

          & > dl.stats {
            order: 3;
            width: 100%;
            justify-content: center;
            margin-inline-end: 0;
          }
        }
      }
    }
  }
</style>