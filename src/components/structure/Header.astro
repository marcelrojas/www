---
import Anchor from '@components/Anchor.astro';
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
import { useTranslations, useTranslatedPath } from '@src/i18n/useTranslations';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
---

<header id="header">
  <div class="content">
    <Anchor class="wordmark" href={translatePath('/')}>www.marcelrojas.net</Anchor>

    <dl class="stats" aria-label="Status">
      <div class="stat">
        <dt>{t('header.time')}</dt>
        <dd><Clock /></dd>
      </div>
    </dl>

    <NavBar />
  </div>
</header>

<style is:global>
  @layer components {
    header#header {
      grid-area: header;
      font-family: var(--font-family-mono);
      line-height: var(--font-leading-normal);

      & > div.content {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        border-bottom: var(--border-width-01) solid var(--border-color);
        padding-inline: 40px;
        padding-block: 12px;

        & > a.wordmark {
          display: inline-flex;
          align-items: center;
          font-family: var(--font-family-mono);
          font-feature-settings: 'zero', 'tnum';
          font-variant-numeric: tabular-nums;
          font-size: var(--font-size-12);
          font-weight: var(--font-weight-semibold);
          letter-spacing: var(--font-tracking-wide);
          line-height: var(--font-leading-normal);
          text-transform: uppercase;
          white-space: pre;
        }

        & > dl.stats {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          column-gap: 24px;
          row-gap: 4px;
          margin: 0;
          margin-inline-end: auto;

          & > div.stat {
            display: flex;
            align-items: baseline;
            gap: 6px;
            font-family: var(--font-family-mono);
            font-size: var(--font-size-12);
            letter-spacing: var(--font-tracking-wide);
            line-height: var(--font-leading-normal);
            text-transform: uppercase;
            white-space: pre;

            & > dt {
              opacity: 0.65;
              font-weight: var(--font-weight-regular);
            }

            & > dd {
              font-weight: var(--font-weight-semibold);
              font-variant-numeric: tabular-nums;
            }
          }
        }
      }

      @media screen and (width <= 860px) {
        & > div.content > dl.stats > div.stat:first-child {
          display: none;
        }
      }

      @media screen and (width <= 560px) {
        & > div.content {
          justify-content: center;
          padding-inline: 20px;

          & > dl.stats {
            order: 3;
            width: 100%;
            justify-content: center;
            margin-inline-end: 0;
          }
        }
      }
    }
  }
</style>