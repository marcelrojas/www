---
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
---

<header id="header">
  <div class="content">
    <div class="gmt">
      <Clock />
    </div>

    <div id="dynamic-content">
      <!-- placeholder -->
    </div>

    <NavBar />
  </div>
</header>

<style is:global>
  @layer components {
    header#header {
      position: absolute;
      z-index: var(--z-header);
      padding-left: calc(var(--spacing-sal) + var(--spacing-06));
      padding-right: calc(var(--spacing-sar) + var(--spacing-06));
  
      & > div.content {
        position: relative;
        display: flex;
        flex-flow: column;
        grid-template-columns: 1fr 1fr;
        grid-template-areas: "a a" "b b" "c c";

        & > div.gmt {
          
        }

        & > div.dynamic-content  {
          
        }

        & > :first-child { grid-area: a; }
        & > :nth-child(2) { grid-area: b; }
        & > :nth-child(3) { grid-area: c; }
      }
    }
  }
</style>
