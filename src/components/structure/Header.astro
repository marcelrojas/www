---
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
---

<header id="header">
  <div class="content">
    <span class="wordmark">
      <span>M</span>
      <span>a</span>
      <span>rc</span>
      <span>el</span>
      <span>Ro</span>
      <span>jas</span>
    </span>

    <div class="gmt">
      <Clock />
    </div>

    <NavBar />
  </div>
</header>

<style is:global>
  @layer component {
    header#header {
      z-index: var(--z-header);
      padding-top: 36px;
      padding-left: calc(var(--spacing-sail) + 0px);
      padding-right: calc(var(--spacing-sair) + 0px);
      user-select: none;
  
      & > div.content {
        display: flex;
        align-items: self-start;
        justify-content: space-between;
        padding-inline: 40px;
        height: 48px;

        span.wordmark {
          width: stretch;
          display: inline-flex;
          justify-content: space-between;
          align-self: center;
          font-family: var(--font-family-mono);
          font-feature-settings: "zero", "tnum";
          font-variant-numeric: tabular-nums;
          font-size: var(--font-size-12);
          font-weight: var(--font-weight-regular);
          letter-spacing: var(--font-tracking-wide);
          line-height: var(--font-leading-normal);
          text-transform: uppercase;
          white-space: pre;
        }

        & > div.gmt {
          display: flex;
          align-items: center;
          justify-content: flex-start;
          height: stretch;
          width: stretch;
          padding-left: 16px;
        }
      }
    }
  }
</style>