---
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
---

<header id="header">
  <div class="content">
    <div class="gmt">
      <Clock />
    </div>

    <div id="dynamic-content">
      <!-- placeholder -->
    </div>

    <NavBar />
  </div>
</header>

<style is:global>
  @layer component {
    header#header {
      position: fixed;
      inset: 0px 0px auto 0px;
      z-index: var(--z-header);
      padding-left: calc(var(--spacing-sail) + 0px);
      padding-right: calc(var(--spacing-sair) + 0px);
      background: var(--sk-header-bg);
  
      & > div.content {
        display: grid;
        lign-items: center;
        grid-template-columns: minmax(0px, 1fr) auto minmax(0px, 1fr);
        height: 48px;

        & > div.gmt {
          display: flex;
          align-items: center;
          justify-content: flex-start;
          height: stretch;
          width: stretch;
          padding-left: 16px;
        }

        & > div.dynamic-content  {
          display: flex;
          align-items: center;
          justify-content: center;
          height: stretch;
          width: stretch;
        }
      }
    }
  }
</style>
