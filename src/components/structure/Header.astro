---
import Clock from '@components/decorators/Clock.astro';
import NavBar from '@components/structure/NavBar.astro';
---

<header id="header">
  <div class="content">
    <div class="gmt">
      <Clock />
    </div>

    <div id="dynamic-content">
      <!-- placeholder -->
    </div>

    <NavBar />
  </div>
</header>

<style is:global>
  @layer component {
    header#header {
      z-index: var(--z-header);
      margin-top: 36px;
      padding-left: calc(var(--spacing-sail) + 0px);
      padding-right: calc(var(--spacing-sair) + 0px);
  
      & > div.content {
        display: flex;
        align-items: self-start;
        justify-content: space-between;
        padding-inline: 40px;
        height: 48px;

        & > div.gmt {
          display: flex;
          align-items: center;
          justify-content: flex-start;
          height: stretch;
          width: stretch;
          padding-left: 16px;
        }

        & > div.dynamic-content  {
          display: flex;
          align-items: center;
          justify-content: center;
          height: stretch;
          width: stretch;
        }
      }
    }
  }
</style>