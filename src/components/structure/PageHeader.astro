---
const { screen_title } = Astro.props;
---

<section id="PageHeader">
  <h1>{screen_title}</h1>
</section>

<style is:global>
  section#PageHeader {
    margin-left: calc(var(--spacing-sal) + var(--spacing-06));
    margin-right: calc(var(--spacing-sar) + var(--spacing-06));
    padding-left: 20px;
    padding-right: 20px;
    padding-block: 20px;
    display: flex;
    justify-content: start;
    align-items: end;
    height: 40vh;
    background-color: #eee;


    @media screen and (width <= 480px) {
      --offset: 56px;
    }

    @media screen and (width > 480px) {
      --offset: 64px;
    }

    & > h1 {
      font-size: var(--font-size-16);
      font-weight: var(--font-weight-regular);
      line-height: 1.05;
      letter-spacing: -.015em;
      text-transform: uppercase;
      color: var(--color-text-primary);
    }
  }
</style>
