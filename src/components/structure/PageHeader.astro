---
const { screen_title } = Astro.props;
---

<div id="PageHeader">
  <h1>{screen_title}</h1>
</div>

<style is:global>
  #PageHeader {
    margin-left: calc(var(--spacing-sal) + var(--spacing-06));
    margin-right: calc(var(--spacing-sar) + var(--spacing-06));
    padding-inline: 20px;
    padding-block: 20px;
    display: contents;

    & > h1 {
      --page-header-text-size: var(--font-size);
      display: inline-block;
      font-size: var(--page-header-text-size);
      font-weight: var(--font-weight-bold);
      line-height: var(--font-leading-very-compact);
      letter-spacing: var(--font-tracking-wide);
      text-transform: uppercase;
      text-align: center;
      backface-visibility: hidden;
      transform-style: preserve-3d;

      @media screen and (width <= 480px) {
        --font-size: var(--font-size-18);
      }

      @media screen and (width > 480px) {
        --font-size: var(--font-size-20);
      }
    }
  }
</style>