---
import Grain from '@components/decorators/Grain.astro';
import Anchor from '@components/Anchor.astro';
import Button from '@components/Button.astro';
import { EMAIL, COPYRIGHT_NAME, COPYRIGHT_YEAR } from '@src/types/consts';

const { encEmail = EMAIL } = Astro.props;
---

<footer id="footer" aria-label="Site footer" tabindex="-1">
  <div class="content">

    <aside>
      <Button id="clipboard-clipper" class="enc-email" type="button" data-hex={encEmail} aria-label="Copy email address">Copy my email</Button>
    </aside>

    <nav aria-label="Find me on the web">
      <ul>
        <li>
          <Anchor variant="gui2" label="text-and-icon" size="medium" href={SOCIAL_X} target="_blank" rel="noopener noreferrer" aria-label={`Visit my X profile`}>X</Anchor>
        </li>
        <li>
          <Anchor variant="gui2" label="text-and-icon" size="medium" href={SOCIAL_INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label={`Visit my Instagram profile`}>Instagram</Anchor>
        </li>
        <li>
          <Anchor variant="gui2" label="text-and-icon" size="medium" href={SOCIAL_YOUTUBE} target="_blank" rel="noopener noreferrer" aria-label={`Visit my YouTube profile`}>YouTube</Anchor>
        </li>
        <li>
          <Anchor variant="gui2" label="text-and-icon" size="medium" href={SOCIAL_GITHUB} target="_blank" rel="noopener noreferrer" aria-label={`Visit my GitHub profile`}>GitHub</Anchor>
        </li>
      </ul>
    </nav>

    <div class="legal">
      <Grain />

      <nav aria-label="Legal">
        <ul>
          <li>
            <a href="/colophon">Colophon</a>
          </li>
          <li>
            <a href="/impressum">Impressum</a>
          </li>
          <li>
            <a href="/privacy-policy">Privacy Policy</a>
          </li>
        </ul>
      </nav>

      <small class="copyright">&copy; {COPYRIGHT_YEAR} {COPYRIGHT_NAME}. All rights reserved.</small>
    </div>
    
  </div>
</footer>

<style is:global>
  @layer components {
    footer#footer {
      contain: layout paint;
      content-visibility: auto;
      pointer-events: none;

      & > div.content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 48px 22px 144px;
        position: relative;

        & a {

          &:hover {
            opacity: 1;
          }

          &:focus-visible {
            outline: 2px solid currentColor;
            outlineOffset: 4px;
          }
        }

        @media screen and (width <= 768px) {
          flex-direction: column;
        }

        @media screen and (width > 768px) {
          flex-direction: row;
        }

        & > aside {
          position: relative;

          & > span.section-tag {
            font-family: var(--font-family-sans);
            font-weight: var(--font-weight-regular);
            font-size: var(--font-size-12);
            text-transform: uppercase;
          }
        }

        & > div.legal {
          position: relative;
          display: flex;
          flex-direction: column;
          align-self: start;
          align-items: baseline;
          gap: var(--spacing-06);
          text-transform: uppercase;

          & > nav {
            position: relative;
            display: block;
            align-self: start;

            & > ul {
              position: relative;
              display: flex;
              flex-direction: row;
              gap: var(--spacing-04);
              font-size: var(--font-size-12);
            }
          }

          & > small.copyright {
            position: relative;
            display: block;
            font-family: var(--font-family-sans);
            font-size: var(--font-size-14);
          }
        }
      }
    }
  }
</style>

<script>
  import "@scripts/encEmail.js";
</script>
