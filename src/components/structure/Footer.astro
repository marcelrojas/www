---
import Anchor from '@components/Anchor.astro';
import Button from '@components/Button.astro';
import {
  EMAIL,
  SOCIAL_TWITTER,
  SOCIAL_INSTAGRAM,
  SOCIAL_YOUTUBE,
  SOCIAL_GITHUB,
  SOCIAL_LINKEDIN,
  SOCIAL_CONTRA,
  COPYRIGHT_NAME,
  COPYRIGHT_YEAR,
} from '@src/types/consts';
import { useTranslations, useTranslatedPath } from '@src/i18n/useTranslations';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
---

<footer id="footer" aria-label="Site footer" tabindex="-1">
  <div class="content">
    <nav class="contact" aria-label="Find me on the web">
      <ul>
        <li>
          <Anchor href={SOCIAL_TWITTER}>Twitter</Anchor>
        </li>
        <li>
          <Anchor href={SOCIAL_INSTAGRAM}>Instagram</Anchor>
        </li>
        <li>
          <Anchor href={SOCIAL_YOUTUBE}>YouTube</Anchor>
        </li>
        <li>
          <Anchor href={SOCIAL_GITHUB}>GitHub</Anchor>
        </li>
      </ul>
    </nav>

    <div class="legal">
      <nav aria-label="Legal">
        <ul>
          <li>
            <Anchor href={translatePath('/colophon')}>{t('footer.colophon')}</Anchor>
          </li>
          <li>
            <Anchor href={translatePath('/impressum')}>{t('footer.impressum')}</Anchor>
          </li>
          <li>
            <Anchor rel="privacy-policy" href={translatePath('/privacy-policy')}>{t('footer.privacy')}</Anchor>
          </li>
        </ul>
      </nav>

      <small class="copyright">&copy; {COPYRIGHT_YEAR} {COPYRIGHT_NAME}. {t('footer.rights')}</small>
    </div>
  </div>
</footer>

<style is:global>
  @layer components {
    footer#footer {
      contain: layout paint;
      content-visibility: auto;
      /*z-index: var(--z-negative);*/
      user-select: none;
      /*position: sticky;
      bottom: 0;*/

      & > div.content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 48px 24px 144px;
        font-family: var(--font-family-mono);
        font-size: var(--font-size-12);
        text-transform: uppercase;

        & a {

          &:hover {
            
          }

          &:focus-visible {
            outline: 2px solid currentColor;
            outline-offset: 4px;
          }
        }

        @media screen and (width <= 768px) {
          
        }

        @media screen and (width > 768px) {
          
        }

        & > nav.contact {
          display: flex;
          align-items: center;
          flex-direction: row;
          gap: 24px;

          & > ul {
            display: flex;
            flex-direction: row;
            gap: 24px;
          }
        }

        & > div.legal {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 8px;
          line-height: 1.6;
          letter-spacing: 0.05em;

          & > nav {
          display: flex;
          flex-direction: row;
          align-items: baseline;

            & > ul {
              display: flex;
              flex-direction: row;
              gap: var(--spacing-04);
            }
          }
        }
      }
    }
  }
</style>

<script>
  import '@src/lib/encEmail';
</script>