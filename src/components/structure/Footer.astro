---
import Grain from '@components/decorators/Grain.astro';
import Anchor from '@components/Anchor.astro';
import Button from '@components/Button.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIAL_X, SOCIAL_INSTAGRAM, SOCIAL_YOUTUBE, SOCIAL_GITHUB, EMAIL, COPYRIGHT_NAME, COPYRIGHT_YEAR } from '@src/types/consts';

const { encEmail = EMAIL } = Astro.props;
---

<footer id="footer" aria-label="Site footer" tabindex="-1">
  <div class="content">
    <Grain />

    <nav class="contact" aria-label="Find me on the web">
      <Button id="clipboard-clipper" class="enc-email" type="button" data-hex={encEmail} aria-label="Copy email address">Copy my email</Button>
      <ul>
        <li>
          <Anchor label="text-only" size="medium" href={SOCIAL_X} target="_blank" rel="noopener noreferrer" aria-label={`Visit my X profile`}>X</Anchor>
        </li>
        <li>
          <Anchor label="text-only" size="medium" href={SOCIAL_INSTAGRAM} target="_blank" rel="noopener noreferrer" aria-label={`Visit my Instagram profile`}>Instagram</Anchor>
        </li>
        <li>
          <Anchor label="text-only" size="medium" href={SOCIAL_YOUTUBE} target="_blank" rel="noopener noreferrer" aria-label={`Visit my YouTube profile`}>YouTube</Anchor>
        </li>
        <li>
          <Anchor label="text-only" size="medium" href={SOCIAL_GITHUB} target="_blank" rel="noopener noreferrer" aria-label={`Visit my GitHub profile`}>GitHub</Anchor>
        </li>
      </ul>
    </nav>

    <div class="legal">

      <nav aria-label="Legal">
        <ul>
          <li>
            <a href="/colophon">Colophon</a>
          </li>
          <li>
            <a href="/impressum">Impressum</a>
          </li>
          <li>
            <a href="/privacy-policy">Privacy Policy</a>
          </li>
        </ul>
      </nav>

      <small class="copyright">&copy; {COPYRIGHT_YEAR} {COPYRIGHT_NAME}. All rights reserved.</small>
    </div>
    
  </div>
</footer>

<style is:global>
  @layer components {
    footer#footer {
      contain: layout paint;
      content-visibility: auto;
      pointer-events: none;

      & > div.content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 48px 24px 144px;
        color: var(--sk-color-text-muted);

        & a {

          &:hover {
            opacity: 1;
          }

          &:focus-visible {
            outline: 2px solid currentColor;
            outlineOffset: 4px;
          }
        }

        @media screen and (width <= 768px) {
          
        }

        @media screen and (width > 768px) {
          
        }

        & > nav.contact {
          display: flex;
          align-items: center;
          flex-direction: row;
          gap: 24px;
          text-transform: uppercase;

          & > button {

          }

          & > ul {
            display: flex;
            align-items: center;
            flex-direction: row;
            gap: 24px;
            font-size: var(--font-size-12);
          }
        }

        & > div.legal {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 8px;
          font-size: 10px;
          line-height: 1.6;
          letter-spacing: 0.05em;
          text-transform: uppercase;

          & > nav {
          display: flex;
          flex-direction: row;
          align-items: baseline;

            & > ul {
              display: flex;
              flex-direction: row;
              gap: var(--spacing-04);
              font-size: var(--font-size-12);
            }
          }

          & > small.copyright {
            display: block;
            font-family: var(--font-family-sans);
            font-size: var(--font-size-12);
          }
        }
      }
    }
  }
</style>

<script>
  import "@scripts/encEmail.js";
</script>
