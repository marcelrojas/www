---
import Grain from '@components/decorators/Grain.astro';
import Anchor from '@components/Anchor.astro';
import Button from '@components/Button.astro';
import { EMAIL, COPYRIGHT_NAME, COPYRIGHT_YEAR } from '@src/types/consts';

const { encEmail = EMAIL } = Astro.props;
---

<!--Button id="footer-toggle" type="button" aria-controls="footer" aria-expanded="false" aria-label="Toggle footer">Further information</Button-->

<footer id="footer" aria-label="Global footer" tabindex="-1">

  <div class="content">

    <aside aria-label="Contact me">
      <Button id="clipboard-clipper" class="enc-email" type="button" data-hex={encEmail} aria-label="Copy email address">Tab to copy my e-mail</Button>
    </aside>

    <div class="legal">
      <Grain />

      <small class="copyright">&copy; {COPYRIGHT_YEAR} {COPYRIGHT_NAME}. All rights reserved.</small>

      <nav aria-label="Legal">
        <ul>
          <li>
            <Anchor variant="gui2" label="text-only" size="small" href="/colophon">Colophon</Anchor>
          </li>
          <li>
            <Anchor variant="gui2" label="text-only" size="small" href="/impressum">Impressum</Anchor>
          </li>
          <li>
            <Anchor variant="gui2" label="text-only" size="small" href="/privacy-policy">Privacy Policy</Anchor>
          </li>
        </ul>
      </nav>
    </div>

  </div>

</footer>

<style is:global>
  @layer components {
    footer#footer {
      position: fixed;
      inset: auto 0px 0px 0px;
      padding: 22px;
      contain: layout paint;
      content-visibility: auto;
      pointer-events: none;
      background-color: var(--background-primary);

      & > div.content {
        display: flex;
        justify-content: space-between;
        position: relative;
        height: 100%;

        @media screen and (width <= 768px) {
          flex-direction: column;
        }

        @media screen and (width > 768px) {
          flex-direction: row;
        }

        & > aside {
          position: relative;

          & > span.section-tag {
            font-family: var(--font-family-sans);
            font-weight: var(--font-weight-regular);
            font-size: var(--font-size-12);
            text-transform: uppercase;
          }
        }

        & > div.legal {
          position: relative;
          display: flex;
          gap: var(--spacing-06);
          flex-direction: row;
          align-self: start;
          align-items: baseline;

          & > small.copyright {
            position: relative;
            display: block;
            font-family: var(--font-family-sans);
            font-size: var(--font-size-14);
          }

          & > nav {
            position: relative;
            display: block;
            align-self: start;

            & > ul {
              position: relative;
              display: flex;
              flex-direction: row;
              gap: var(--spacing-04);
              font-size: var(--font-size-12);
            }
          }
        }
      }
    }
  }
</style>

<script>
  import "@scripts/encEmail.js";
</script>
