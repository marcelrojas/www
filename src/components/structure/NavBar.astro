---
import Anchor from '@components/Anchor.astro';

const anchors = [
  { href: "/", text: "About" },
  { href: "/services", text: "Services" },
  { href: "/showcase", text: "Showcase" },
  { href: "/resources", text: "Resources" },
];
---

<nav id="haptic-nav" class="navbar" aria-label="Main">
  <ul>
    {anchors.map(link => (
      <li>
        <Anchor size="large" href={link.href}>{link.text}</Anchor>
      </li>
    ))}
  </ul>
</nav>

<style is:global>
  @layer component {
    nav.navbar {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      height: stretch;
      width: stretch;

      & > ul {
        display: flex;
        flex-flow: row;
        align-items: center;
        height: stretch;

        & > li {
          width: fit-content;

          & > a {
            padding-inline: 20px;
            line-height: 1;
            white-space: nowrap;
          }
        }
      }
    }
  }
</style>
