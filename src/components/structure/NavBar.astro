---
import { useTranslations } from '@/i18n/useTranslations';
const t = useTranslations(Astro.currentLocale);
import Anchor from '@components/Anchor.astro';

const anchors = [
  { href: "/", text: "About" },
  { href: "/showcase", text: "Showcase" },
  { href: "/weblog", text: "Weblog" },
  { href: "/resources", text: "Resources" },
];
---

<nav id="haptic-nav" class="navbar" aria-label="Main">
  <ul>
    {anchors.map(link => (
      <li>
        <Anchor href={link.href}>{link.text}</Anchor>
      </li>
    ))}
  </ul>
</nav>

<style is:global>
  @layer component {
    nav.navbar {
      display: flex;
      align-items: center;
      height: stretch;
      width: stretch;

      & > ul {
        display: flex;
        flex-flow: column;
        height: stretch;

        & > li {
          width: fit-content;

          & > a {
            font-family: var(--font-family-sans);
            font-size: var(--font-size-18);
            line-height: var(--font-leading-normal);
          }
        }
      }
    }
  }
</style>