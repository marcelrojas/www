---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_AUTHOR, SITE_KEYWORDS } from '@src/types/consts';
import '@styles/variables.css';
import '@styles/global.css';
import Schema from '@components/Schema.astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  lang?: 'en' | 'es';
}

const FallbackImage = '/og.png';
const {
  title,
  description,
  image = FallbackImage,
  lang = 'en'
} = Astro.props;

const ogLocale = lang === 'es' ? 'es_VE' : 'en_US';
const siteOrigin = Astro.site ?? new URL('https://marcelrojas.net');

const pathname = Astro.url.pathname
  .replace(/^\/index\.html$/, '/')
  .replace(/\.html$/, '');
const canonicalURL = new URL(pathname, siteOrigin);
const localeMatch = pathname.match(/^\/(es)(\/.*)?$/);
const basePath = localeMatch ? (localeMatch[2] || '/') : pathname;
const esPath = basePath === '/' ? '/es' : `/es${basePath}`;

const imageSrc = typeof image === 'string' ? image : image.src;
const ogImageURL = new URL(imageSrc, siteOrigin);
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="author" content={SITE_AUTHOR} />
  <meta name="keywords" content={SITE_KEYWORDS.join(', ')} />

  <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="en" href={new URL(basePath, siteOrigin)} />
  <link rel="alternate" hreflang="es" href={new URL(esPath, siteOrigin)} />
  <link rel="alternate" hreflang="x-default" href={new URL(basePath, siteOrigin)} />

  <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />

  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f6f5" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0f12" />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', siteOrigin)} />
  <link rel="search" type="application/opensearchdescription+xml" title={`Search ${SITE_TITLE}`} href="/opensearch.xml" />
  <link rel="privacy-policy" href="/privacy-policy" />

  <meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- OpenGraph / GEO Metadata -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:locale" content={ogLocale} />
  {ogLocale === 'en_US' && <meta property="og:locale:alternate" content="es_VE" />}
  {ogLocale === 'es_VE' && <meta property="og:locale:alternate" content="en_US" />}

  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:creator" content="@whyismarcel" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImageURL} />

  <!-- Analytics -->
  <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-42TF8GHE8N"></script>
  <script type="text/partytown">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-42TF8GHE8N');

  document.addEventListener('astro:page-load', () => {
    gtag('config', 'G-42TF8GHE8N', {
      page_path: window.location.pathname,
    });
  });
  </script>

  <!-- Forms -->
  <script type="text/partytown" async src="https://tally.so/widgets/embed.js"></script>

  <!-- Structured Data for AEO / GEO Answer Engines -->
  <Schema title={title} description={description} canonicalURL={canonicalURL.toString()} lang={lang} />

  <script defer src="/script.js"></script>
  <ClientRouter fallback="animate" />
</head>