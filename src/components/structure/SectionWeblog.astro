---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '@components/FormattedDate.astro';
import featured from '@data/featured.json';

const posts = (await getCollection('weblog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<section id="post-list" role="feed" aria-busy="false" aria-label="List of blog articles">
  <div class="content">
    <h2>Weblog</h2>

    <p>Thoughts on code, design, and my passion for everything. Latest posts and updates.</p>

    {
      posts.map(post => (
        <article class="post-item">
          <a href={`/resources/${post.id}`}>
            <h2>{post.data.title}</h2>
            <p class="summary">{post.data.description}</p>
            <div class="metadata">
              <FormattedDate date={post.data.pubDate} />
              <span class="category">{post.data.category}</span>
            </div>
          </a>
        </article>
      ))
    }
  </div>

  <section id="section-featured" role="feed" aria-busy="false" aria-label="List of articles and publications">
    <div class="content">
      <h3>As featured in</h3>

      <div>
        {
          Object.values(featured).map((featured) => (
            <article>
              <h2 class="headline">
                <a href={featured.url} target="_blank" rel="noopener noreferrer">{featured.title}</a>
              </h2>
              <cite class="publisher">Published by: <a href={featured.url} target="_blank" rel="noopener noreferrer">{featured.publisher}</a></cite>
            </article>
          ))
        }
      </div>

    </div>
  </section>


    <figure>
      <picture>
        <img src="" alt="" />
      </picture>
      <figcaption>
        <img src="" aria-hidden="true" />
        <div class="">
          <h3>THE RAMP is OUT NOW!</h3>
          <date>Tue, August 3, 2021 9:05 AM PDT</date>
        </div>
      </figcaption>
    </figure>
 </section>

<style is:global>
  section#post-list {
    position: relative;
    padding-top: var(--spacing-11);
    padding-bottom: var(--spacing-11);

    & > div.content {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-03);
      max-width: 980px;
      padding-inline-start: calc(var(--spacing-sal) + var(--spacing-06));
      padding-inline-end: calc(var(--spacing-sar) + var(--spacing-06));
      margin-left: auto;
      margin-right: auto;

      & > article.post-item {
        position: relative;
        overflow: hidden;
        user-select: none;
        background-color: var(--background-secondary);

        & > a {
          color: inherit;
          display: block;
          padding: var(--spacing-06);

          &:visited {
            color: var(--accent-visited);
          }

          & > h2 {
            max-width: 300px;
            margin-bottom: var(--spacing-03);
            font-family: var(--font-family-sans);
            font-weight: var(--font-weight-medium);
            font-size: var(--font-size-18);
            line-height: 1;
            line-clamp: 3;
            box-orient: vertical;
            color: var(--label-primary);
          }

          & > p.summary {
            margin-top: var(--spacing-02);
            margin-bottom: var(--spacing-04);
            max-width: 300px;
            font-family: var(--font-family-sans);
            font-weight: var(--font-weight-medium);
            font-size: var(--font-size-16);
            line-height: var(--line-height-24);
            line-clamp: 3;
            box-orient: vertical;
            color: var(--label-secondary);
          }

          & > .metadata {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.9rem;

            & > span.category {
              border-width: 0 0 0 1px;
              border-style: solid;
              border-color: var(--fill-border);
            }
          }
        }
      }

      & > :first-child { grid-area: a; }
      & > :nth-child(2) { grid-area: b; }
      & > :nth-child(3) { grid-area: c; }
      & > :nth-child(4) { grid-area: d; }
      & > :nth-child(5) { grid-area: e; }
    }
  }

  section#section-featured {
    position: relative;
    padding-top: var(--spacing-11);
    padding-bottom: var(--spacing-11);

    & > div.content {
      max-width: 980px;
      padding-inline-start: calc(var(--spacing-sal) + 22px);
      padding-inline-end: calc(var(--spacing-sar) + 22px);
      margin-left: auto;
      margin-right: auto;
      overflow-wrap: break-word;
      text-wrap: pretty;

      & > div {
        padding: var(--spacing-03);
        gap: var(--spacing-03);
        display: flex;
        flex-direction: column;
        background-color: var(--sk-color-fill-);

        & > article {
          position: relative;
          display: flex;
          flex-direction: column;
          overflow: hidden;
          padding: var(--spacing-05);
          background-color: var(--background-primary);
          will-change: opacity, transform;
          user-select: none;

          @starting-style {
            opacity: 0;
            transform: translateY(20px)
          }

          &:focus-visible {
            outline: 2px solid var(--color-focus);
            outline-offset: 2px
          }

          & > h2.headline {
            max-width: 300px;
            display: flex;
            justify-content: space-between;
            font-family: var(--font-family-sans);
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-20);
            line-height: var(--line-height-24);
            line-clamp: 3;
            align-items: baseline;
            color: var(--color-label-primary);
          }

          & > cite.publisher {
            margin-top: var(--spacing-04);
            font-family: var(--font-family-sans);
            font-weight: var(--font-weight-medium);
            font-size: var(--font-size-12);
            line-height: var(--font-leading-tight);
            line-clamp: 1;
            color: var(--color-label-secondary)
          }
        }
      }
    }
  }
</style>