<grain-overlay aria-hidden="true">
  <canvas></canvas>
</grain-overlay>

<style is:global>
  @layer component {
    grain-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100dvw;
      height: 100dvh;
      z-index: 1;
      display: block;
      pointer-events: none;

      & > canvas {
        width: 100%;
        height: 100%;
        display: block;
      }
    }
  }
</style>

<script>
  class GrainOverlay extends HTMLElement {
    constructor() {
      super();
      this.canvas = this.querySelector('canvas');
      this.ctx = this.canvas?.getContext('2d');

      this.patternSize = 64;
      this.patternAlpha = 20;

      this.patternCanvas = document.createElement('canvas');
      this.patternCtx = this.patternCanvas.getContext('2d');
      this.patternData = null;
      this.pattern = null;
      this.frameId = null;
      this.observer = null;
      this.lastFrameTime = 0;
      this.fpsInterval = 1000 / 24; // 24 FPS is visually indistinguishable for grain animation while saving ~60-80% CPU/GPU work
      this.isIntersecting = false;

      // prevent memory-leaks
      this.animate = this.animate.bind(this);
      this.onResize = this.resize.bind(this);
      this.onVisibilityChange = this.onVisibilityChange.bind(this);
    }

    // connectedCallback is native on Web Components and get triggered when the Element enter DOM
    connectedCallback() {
      if (!this.canvas || !this.ctx) return;

      window.addEventListener('resize', this.onResize);
      document.addEventListener('visibilitychange', this.onVisibilityChange);
      this.resize();
      this.createPattern();

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          this.isIntersecting = entry.isIntersecting;
          if (this.isIntersecting && !document.hidden) {
            this.start();
          } else {
            this.stop();
          }
        });
      });

      this.observer.observe(this);
    }

    // disconnectedCallback, bye-bye memory leaks!
    disconnectedCallback() {
      this.stop();
      window.removeEventListener('resize', this.onResize);
      document.removeEventListener('visibilitychange', this.onVisibilityChange);
      if (this.observer) this.observer.disconnect();
    }

    onVisibilityChange() {
      if (document.hidden) {
        this.stop();
      } else if (this.isIntersecting) {
        this.start();
      }
    }

    start() {
      if (!this.frameId && !document.hidden && this.isIntersecting) {
        this.lastFrameTime = performance.now() - this.fpsInterval;
        this.animate(performance.now());
      }
    }

    stop() {
      if (this.frameId) {
        window.cancelAnimationFrame(this.frameId);
        this.frameId = null;
      }
    }

    resize() {
      if (!this.canvas) return;
      this.canvas.width = this.clientWidth * window.devicePixelRatio;
      this.canvas.height = this.clientHeight * window.devicePixelRatio;
      if (this.patternCanvas && this.ctx) {
        this.pattern = this.ctx.createPattern(this.patternCanvas, 'repeat');
      }
    }

    createPattern() {
      if (!this.patternCtx || !this.ctx) return;
      this.patternCanvas.width = this.patternSize;
      this.patternCanvas.height = this.patternSize;
      this.patternData = this.patternCtx.createImageData(this.patternSize, this.patternSize);

      const data = this.patternData.data;

      // Uint8ClampedArray prevent Endianness
      for (let i = 0; i < data.length; i += 4) {
        const value = Math.random() * 255;
        data[i]     = value; // Red
        data[i + 1] = value; // Green
        data[i + 2] = value; // Blue
        data[i + 3] = this.patternAlpha; // Alpha
      }

      this.patternCtx.putImageData(this.patternData, 0, 0);
      // Cache CanvasPattern object to eliminate allocations on every frame
      this.pattern = this.ctx.createPattern(this.patternCanvas, 'repeat');
    }

    animate(now) {
      this.frameId = window.requestAnimationFrame(this.animate);

      // Throttle grain rendering to ~24 FPS to avoid wasteful 60Hz/120Hz continuous redraws
      const elapsed = now - this.lastFrameTime;
      if (elapsed < this.fpsInterval) return;

      this.lastFrameTime = now - (elapsed % this.fpsInterval);

      if (!this.ctx || !this.pattern) return;

      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      const x = Math.random() * this.patternSize;
      const y = Math.random() * this.patternSize;

      this.ctx.save();
      this.ctx.translate(x, y);

      this.ctx.fillStyle = this.pattern;
      this.ctx.fillRect(-x, -y, this.canvas.width + x, this.canvas.height + y);

      this.ctx.restore();
    }
  }

  if (!customElements.get('grain-overlay')) {
    customElements.define('grain-overlay', GrainOverlay);
  }
</script>