---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'button'> {
  id?: string;
  as?: 'button' | 'input';
  type?: 'button' | 'submit' | 'reset';
  action?: 'default' | 'neutral' | 'cta' | 'danger';
  size?: 'small' | 'medium' | 'large' | 'full';
  wide?: 'fit' | 'fill' | 'full';
  class?: string;
  isActive?: boolean;
  disabled?: boolean;
  labelId?: string;
  command?: string;
  commandfor?: string;
}

const {
  id: userID,
  as = 'button',
  type = 'button',
  action = 'default',
  size = 'medium',
  wide = 'fit',
  class: userClass,
  isActive = false,
  disabled = false,
  labelId,
  ...rest
} = Astro.props;

const classList = [
  'mr-button',
  'button',
  `mr-button--${action}`,
  `action-${action}`,
  `mr-button--${size}`,
  `size-${size}`,
  `wide-${wide}`,
  userClass,
];
---

{as === 'input' ? (
  <input
    id={userID}
    type={type}
    class:list={classList}
    aria-labelledby={labelId}
    aria-current={isActive ? 'true' : undefined}
    disabled={disabled || undefined}
    aria-disabled={disabled ? 'true' : undefined}
    tabindex={disabled ? -1 : undefined}
    {...rest}
  />
) : (
  <button
    id={userID}
    type={type}
    class:list={classList}
    aria-labelledby={labelId}
    aria-current={isActive ? 'true' : undefined}
    disabled={disabled || undefined}
    aria-disabled={disabled ? 'true' : undefined}
    tabindex={disabled ? -1 : undefined}
    {...rest}
  >
    <slot />
  </button>
)}

<style is:global>
  @layer components {
    :is(button, input:is([type="button"], [type="submit"], [type="reset"])).mr-button {
      --btn-fg: var(--mr-text-primary);
      --btn-accent: var(--mr-text-accent);
      --btn-danger: var(--mr-status-danger);
      --btn-bg-cta: var(--mr-surface-inverse);
      --btn-fg-inverse: var(--mr-text-inverse);
      --btn-focus: var(--mr-focus-ring);

      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-feature-settings: "zero", "tnum";
      font-variant-numeric: tabular-nums;
      font-weight: var(--font-weight-medium);
      letter-spacing: var(--font-tracking-wide);
      text-transform: uppercase;
      white-space: pre;
      will-change: background-color, color, opacity;
      transition: background-color 0.15s linear, color 0.15s linear, opacity 0.15s linear;

      &:focus-visible {
        outline: 2px solid var(--btn-focus);
        outline-offset: 2px;
      }

      &:disabled,
      &[aria-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.5;
      }

      &.size-small {
        gap: 3px;
        padding-inline: 10px;
        padding-block: 4px;
        font-size: var(--font-size-12);
      }

      &.size-medium {
        gap: 4px;
        padding-inline: 14px;
        padding-block: 7px;
        font-size: var(--font-size-14);
      }

      &.size-large {
        gap: 5px;
        padding-inline: 20px;
        padding-block: 14px;
        font-size: var(--font-size-16);
      }

      &.action-default,
      &.action-neutral {
        background-color: transparent;
        color: var(--btn-fg);

        @media only screen and (hover: hover) {
          &:hover:not(:disabled, [aria-disabled="true"]) {
            color: var(--btn-accent);
          }
        }
      }

      &.action-cta {
        background-color: var(--_btn-bg-cta);
        color: var(--btn-fg-inverse);

        @media only screen and (hover: hover) {
          &:hover:not(:disabled, [aria-disabled="true"]) {
            opacity: 0.9;
            transform: translateY(-1px);
          }
        }
      }

      &.action-danger {
        background-color: transparent;
        color: var(--btn-danger);

        @media only screen and (hover: hover) {
          &:hover:not(:disabled, [aria-disabled="true"]) {
            opacity: 0.82;
          }
        }
      }

      &.wide-fill,
      &.wide-full {
        inline-size: 100%;
      }

      @media (prefers-reduced-motion: reduce) {
        transition: none;

        &:hover,
        &:active {
          transform: none;
        }
      }
    }
  }
</style>