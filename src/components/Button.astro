---
interface Props {
  id?: string;
  as?: 'button'| 'input';
  type?: 'button' | 'submit' | 'reset';
  action?: 'neutral' | 'danger';
  size?: 'small' | 'medium' | 'large' | 'full';
  wide?: 'fit' | 'fill';
  class?: string;
  isActive?: boolean;
  disabled?: boolean;
  labelId?: string;
  [key: string]: any;
}

const {
  id: userID,
  as = 'button',
  type = 'button',
  action = 'default',
  size = 'medium',
  wide = 'fit',
  class: userClass,
  isActive = true,
  disabled = false,
  labelId,
  ...rest
} = Astro.props;

const Tag = as === 'input' ? 'input' : 'button';

const attrs: Record<string, any> = {
  ...rest,
  type: type,
  disabled: disabled ? true : undefined,
  'aria-disabled': disabled ? 'true' : undefined,
  tabindex: disabled ? -1 : undefined,
};

const classList = [
  userID,
  'button',
  `action-${action}`,
  `size-${size}`,
  `wide-${wide}`,
  userClass,
].filter(Boolean).join(' ');
---

<Tag
  id={userID}
  class={classList}
  aria-labelledby={labelId}
  aria-current={isActive ? "true" : undefined}
  {...attrs}
>
  <slot />
</Tag>

<style is:global>
  @layer component {
    :is(button, input:is([type="button"], [type="submit"], [type="reset"])).button {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      font-family: var(--font-family-mono);
      font-feature-settings: "zero", "tnum";
      font-variant-numeric: tabular-nums;
      font-weight: var(--font-weight-medium);
      letter-spacing: var(--font-tracking-wide);
      text-transform: uppercase;
      white-space: pre;
      will-change: background-color, color, opacity;
      transition: background-color 0.15s linear, color 0.15s linear, opacity 0.15s linear;

      &:active:not(:disabled, [aria-disabled="true"]) {

      }

      &.size-small {
        gap: 3px;
        padding-inline: 10px;
        padding-block: 4px;
        font-size: var(--font-size-12);
      }

      &.size-medium {
        gap: 4px;
        padding-inline: 14px;
        padding-block: 7px;
        font-size: var(--font-size-14);
      }

      &.size-large {
        gap: 5px;
        padding-inline: 20px;
        padding-block: 14px;
        font-size: var(--font-size-16);
      }

      &.action-neutral {
        background-color: transparent;
        color: var(--text-primary);
        fill: var(--text-primary);

        &:is(:focus, :focus-visible) {
          color: var(--brand-red);
          outline: 2px solid var(--brand-red);
          outline-offset: -2px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--brand-red);
          }
        }
      }

      &.action-cta {
        background-color: transparent;
        color: var(--text-primary);
        fill: var(--text-primary);

        &:focus, &:focus-visible {
          box-shadow: rgba(8, 40, 69, 0.35) 0px 0px 0px 1px inset;
          outline: rgb(255, 255, 255) solid 2px;
          outline-offset: -4px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--);
          }
        }
      }

      &.action-danger {
        background-color: transparent;
        color: var(--color-danger);
        fill: var(--color-danger);

        &:focus, &:focus-visible {
          box-shadow: rgba(8, 40, 69, 0.35) 0px 0px 0px 1px inset;
          outline: rgb(255, 255, 255) solid 2px;
          outline-offset: -4px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--);
          }
        }
      }

      &.wide-full { width: 100%; }

      @media (hover: hover) {
        &:hover:not(:disabled, [aria-disabled="true"]) {
          .action-default & {
            
          }

          .action-neutral & {
            
          }

          .action-danger & {

          }
        }
      }
    }
  }
</style>
