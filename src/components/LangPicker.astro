---
import Anchor from '@components/Anchor.astro';
import { languages } from '@src/i18n/ui';
import { getLangFromUrl, useTranslatedPath, type Locale } from '@src/i18n/useTranslations';

interface Props {
  editions?: Array<{ lang: string; title: string; url: string }>;
  isPost?: boolean;
}

const { editions = [], isPost = false } = Astro.props;
const currentLocale = (Astro.currentLocale as Locale | undefined) ?? getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLocale);

// Strip active locale prefix (/es) and any trailing .html from pathname
const basePath =
  Astro.url.pathname
    .replace(/^\/es(?=\/|$)/, '')
    .replace(/\/index\.html$/, '')
    .replace(/\.html$/, '') || '/';

function hrefFor(code: Locale): string {
  if (isPost) {
    const edition = editions.find((e) => e.lang === code);
    if (edition) return edition.url;
    return translatePath('/blog', code);
  }
  return translatePath(basePath, code);
}
---

<nav aria-label="Language switcher" id="lang-picker">
  <ul>
    {(Object.entries(languages) as Array<[Locale, string]>).map(([code, label]) => (
      <li>
        <Anchor
          href={hrefFor(code)}
          lang={code}
          hreflang={code}
          aria-current={code === currentLocale ? 'page' : undefined}
        >
          {label}
        </Anchor>
      </li>
    ))}
  </ul>
</nav>

<style is:global>
  @layer components {
    nav#lang-picker {
      font-family: var(--font-family-sans);

      & > ul {
        display: flex;
        gap: var(--spacing-02, 8px);
        list-style: none;
        margin: 0;
        padding: 0;

        & a {
          padding-inline: var(--spacing-02, 8px);
          font-size: var(--font-size-12, 0.75rem);
          line-height: var(--font-leading-normal, 1.5);
          text-decoration: none;

          &:not([aria-current='page']) {
            background-color: var(--background-primary);
            opacity: 0.75;
          }

          &[aria-current='page'] {
            background-color: var(--background-secondary);
            font-weight: var(--font-weight-semibold, 600);

            &::before {
              content: '<';
            }

            &::after {
              content: '>';
            }
          }
        }
      }
    }
  }
</style>