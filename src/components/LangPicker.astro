---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Anchor from '@components/Anchor.astro';

interface Edition {
  lang: string;
  url: string;
}

interface Props {
  editions?: Edition[];
  isPost?: boolean;
}

const { editions = [], isPost = false } = Astro.props;

const LOCALES = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'ja', label: '日本語' },
] as const;

const currentLocale = Astro.currentLocale ?? 'en';
const path = Astro.url.pathname.replace(/^\/(es|ja)(?=\/|$)/, '') || '/';

function hrefFor(code: string) {
  if (isPost) {
    const edition = editions.find((e) => e.lang === code);
    return edition ? edition.url : getRelativeLocaleUrl(code, '/weblog');
  }
  return getRelativeLocaleUrl(code, path);
}
---

<nav aria-label="Language switcher" id="lang-picker">
  <ul>
    {LOCALES.map(({ code, label }) => (
      <li>
        <Anchor
          href={hrefFor(code)}
          lang={code}
          hreflang={code}
          aria-current={code === currentLocale ? 'true' : undefined}
        >
          {label}
        </Anchor>
      </li>
    ))}
  </ul>
</nav>

<style is:global>
  @layer component {
    nav#lang-picker {
      font-family: var(--font-family-sans);
      
      & > ul {
        display: flex;
        
        & a {
          padding-inline: var(--spacing-02);
          font-size: var(--font-size-12);
          line-heigth: var(--);
          
          &:not([aria-current="page"]) {
            background-color: var(--backgroud-primary);
          }
          
          &[aria-current="page"] {
            background-color: var(--background-secondary);
            
            &::before {
              content: "<";
            }
            
            &::after {
              content: ">";
            }
          }
        }
      }
    }
  }
</style>