---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'gui1' | 'gui2' | 'tui';
  action?: 'neutral' | 'cta';
  size?: 'small' | 'medium' | 'large';
  label?: 'text-only' | 'icon-only' | 'text-and-icon';
  isActive?: boolean;
}

const {
  href,
  class: className,
  variant,
  action = 'neutral',
  size = 'medium',
  label = 'text-only',
  isActive: forceActive,
  ...props
} = Astro.props;

let isCurrentlyActive = forceActive;

if (isCurrentlyActive === undefined && href) {
  try {
    const targetUrl = new URL(href.toString(), Astro.url);
    const targetPath = targetUrl.pathname.replace(/\/$/, '');
    const currentPath = Astro.url.pathname.replace(/\/$/, '');

    isCurrentlyActive = 
      targetPath === currentPath || 
      (targetPath !== '' && currentPath.startsWith(targetPath + '/'));
  } catch (e) {
    isCurrentlyActive = false;
  }
} else if (isCurrentlyActive === undefined) {
  isCurrentlyActive = false; 
}

const isExternal = href?.toString().startsWith('http');
const target = isExternal ? '_blank' : props.target;
const rel = isExternal ? 'noopener noreferrer' : props.rel;

const classes = [
  className,
  'anchor',
  variant ? `variant-${variant}` : '',
  `action-${action}`,
  `size-${size}`,
  `label-${label}`,
  isActive ? 'is-active' : ''
].filter(Boolean).join(' ');
---

<a
  {...props}
  href={href}
  class={classes}
  target={target}
  rel={rel}
  aria-current={isCurrentlyActive ? 'page' : undefined}
  data-astro-prefetch={isExternal ? 'false' : 'viewport'}
>
  <slot />
</a>

<style is:global>
  @layer component {
    :is(a, a[role="button"]).anchor {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      position: relative;
      width: fit-content;
      height: fit-content;
      font-family: var(--font-family-sans);
      text-align: center;
      will-change: background-color, color, opacity;
      transition: background-color 0.15s linear, color 0.15s linear, opacity 0.15s linear;

      @media (hover: hover) {
        &:hover:not([aria-current="page"]) {
          color: var(--accent-hover);
        }
      }

      &[aria-current="page"] {
        font-weight: var(--font-weight-semibold);
        color: var(--accent);
      }

      &:active {

      }

      &:focus-visible {
        outline: 2px solid var(--ring);
      }

      /* Variants */
      &.variant-gui1 {
        font-weight: var(--font-weight-medium);
        text-transform: lowercase;

        @media (hover: hover) {
          &:hover {

          }
        }
      }

      &.variant-gui2 {
        font-weight: var(--font-weight-regular);
        text-transform: uppercase;

        @media (hover: hover) {
          &:hover {

          }
        }
      }

      &.variant-tui {
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: 4px;

        @media (hover: hover) {
          &:hover {

          }
        }
      }

      /* Actions */
      &.action-neutral {
        color: var(--label-);
        fill: var(--label-);
      }

      &.action-cta {
        color: var(--label-primary-controls);
        fill: var(--label-primary-controls);
      }

      /* Sizes */
      &.size-small {
        font-size: var(--font-size-12);

        &.label-text-and-icon {
          gap: 3px;
        }

        &.label-text-only {

        }

        &.label-icon-only {

        }

        & svg {
          width: 8px;
          height: 8px;
        }
      }

      &.size-medium {
        font-size: var(--font-size-14);

        &.label-text-and-icon {
          gap: 5px;
        }

        &.label-text-only {

        }

        &.label-icon-only {

        }

        & svg {
          width: 16px;
          height: 16px;
        }
      }

      &.size-large {
        font-size: var(--font-size-14);

        &.label-text-and-icon {
          gap: 6px;
        }

        &.label-text-only {

        }

        &.label-icon-only {

        }

        & svg {
          width: 32px;
          height: 32px;
        }
      }

      &[role="button"] {
        border-radius: 32px;

        &[aria-pressed="true"] {

        }
      }
    }
  }
</style>
