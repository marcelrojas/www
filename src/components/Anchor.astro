---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'gui1' | 'gui2' | 'gui3';
  action?: 'neutral' | 'cta';
  size?: 'small' | 'medium' | 'large';
  isActive?: boolean;
}

const {
  href,
  class: className,
  variant,
  action = 'neutral',
  size = 'medium',
  isActive: forceActive,
  ...props
} = Astro.props;

let isCurrentlyActive = forceActive;

if (isCurrentlyActive === undefined && href) {
  try {
    const targetUrl = new URL(href.toString(), Astro.url);
    const targetPath = targetUrl.pathname.replace(/\/$/, '');
    const currentPath = Astro.url.pathname.replace(/\/$/, '');

    isCurrentlyActive = 
      targetPath === currentPath || 
      (targetPath !== '' && currentPath.startsWith(targetPath + '/'));
  } catch (e) {
    isCurrentlyActive = false;
  }
} else if (isCurrentlyActive === undefined) {
  isCurrentlyActive = false; 
}

const isExternal = href?.toString().startsWith('http');
const target = isExternal ? '_blank' : props.target;
const rel = isExternal ? 'noopener noreferrer' : props.rel;

const classes = [
  className,
  'anchor',
  variant ? `variant-${variant}` : '',
  `action-${action}`,
  `size-${size}`,
  isCurrentlyActive ? 'is-active' : ''
].filter(Boolean).join(' ');
---

<a
  {...props}
  href={href}
  class={classes}
  target={target}
  rel={rel}
  aria-current={isCurrentlyActive ? 'page' : undefined}
  data-astro-prefetch={isExternal ? 'false' : 'viewport'}
>
  <slot />
</a>

<style is:global>
  @layer component {
    :is(a, a[role="button"]).anchor {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      position: relative;
      width: fit-content;
      height: fit-content;
      font-feature-settings: "zero", "tnum";
      font-variant-numeric: tabular-nums;
      letter-spacing: var(--font-tracking-wide);
      text-align: center;
      white-space: pre;
      will-change: background-color, color, opacity;
      transition: background-color 0.15s linear, color 0.15s linear, opacity 0.15s linear;

      &[aria-current="page"] {
        font-weight: var(--font-weight-semibold);
        color: var(--accent);
      }

      &:active {

      }

      &.variant-gui1 {
        font-weight: var(--font-weight-regular);
        text-transform: uppercase;
      }

      &.variant-gui2 {
        font-weight: var(--font-weight-medium);
        text-transform: uppercase;
      }

      &.variant-gui3 {
        font-weight: var(--font-weight-medium);
        text-transform: lowercase;
      }

      &.action-neutral {
        color: var(--);
        fill: var(--);

        &:is(:focus, :focus-visible) {
          color: var(--brand-red);
          outline: 2px solid var(--brand-red);
          outline-offset: -2px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--brand-red);
          }
        }
      }

      &.action-cta {
        color: var(--);
        fill: var(--);

        &:focus, &:focus-visible {
          box-shadow: rgba(8, 40, 69, 0.35) 0px 0px 0px 1px inset;
          outline: rgb(255, 255, 255) solid 2px;
          outline-offset: -4px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--);
          }
        }
      }

      &.size-small {
        font-size: var(--font-size-12);
        gap: 3px;

        & svg {
          width: 8px;
          height: 8px;
        }
      }

      &.size-medium {
        font-size: var(--font-size-14);
        gap: 5px;

        & svg {
          width: 16px;
          height: 16px;
        }
      }

      &.size-large {
        font-size: var(--font-size-14);
        gap: 6px;

        & svg {
          width: 32px;
          height: 32px;
        }
      }

      &[role="button"] {
        border-radius: 32px;

        &[aria-pressed="true"] {

        }
      }
    }
  }
</style>