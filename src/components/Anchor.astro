---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'a'> {
  /** Destination URL or path. */
  href?: string | URL;
  /** Visual container style of the anchor. */
  variant?: 'default' | 'platted' | 'platterless' | 'underline';
  /** Semantic color intent of the anchor. */
  action?: 'default' | 'neutral' | 'cta' | 'danger';
  /** Component scale and icon sizing. */
  size?: 'small' | 'medium' | 'large';
  /** Horizontal layout behavior. */
  wide?: 'fit' | 'fill' | 'auto';
  /** Internal padding preset based on slot content type. */
  label?: 'text-only' | 'icon-only' | 'text-and-icon';
  /** Forces active state (`aria-current="page"`) or overrides automatic detection. */
  isActive?: boolean;
  /** Highlights parent nav item when visiting nested sub-routes (e.g. `/weblog/post`). */
  matchSubpaths?: boolean;
  /** Overrides Astro prefetch strategy (`false` disables prefetching). */
  prefetch?: boolean | 'hover' | 'tap' | 'viewport' | 'load';
}

const {
  href = '',
  target,
  rel,
  'aria-current': ariaCurrentProp,
  class: className,
  variant = 'default',
  action = 'default',
  size,
  wide = 'fit',
  label,
  isActive: forceActive,
  matchSubpaths = false,
  prefetch,
  ...props
} = Astro.props;

const rawHref = typeof href === 'string' ? href.trim() : String(href ?? '').trim();

const isHash = rawHref.startsWith('#');
const isSpecialProtocol = /^(mailto:|tel:|sms:|javascript:|data:|blob:)/i.test(rawHref);
const isExternal = /^(https?:)?\/\//i.test(rawHref);
const isInternal = rawHref.startsWith('/') && !rawHref.startsWith('//');

const normalizePath = (path: string): string => {
  const clean = path.split(/[?#]/)[0] || '/';
  return clean === '/' ? '/' : clean.replace(/\/+$/, '');
};

const currentPathname = normalizePath(Astro.url?.pathname ?? '/');
const targetPathname = isInternal ? normalizePath(rawHref) : '';

const isCurrentPage =
  forceActive ??
  (isInternal &&
    targetPathname !== '' &&
    (currentPathname === targetPathname ||
      (matchSubpaths &&
        targetPathname !== '/' &&
        currentPathname.startsWith(`${targetPathname}/`))));

const computedTarget = target ?? (isExternal ? '_blank' : undefined);

const computedRel = (() => {
  if (!isExternal && computedTarget !== '_blank') return rel;
  const tokens = new Set((rel ?? '').split(/\s+/).filter(Boolean));
  tokens.add('noopener');
  tokens.add('noreferrer');
  return Array.from(tokens).join(' ');
})();

const computedAriaCurrent =
  ariaCurrentProp ?? (isCurrentPage ? 'page' : undefined);

const computedPrefetch = (() => {
  if (prefetch === false || isExternal || isHash || isSpecialProtocol || !rawHref) {
    return undefined;
  }
  if (typeof prefetch === 'string') return prefetch;
  return 'viewport';
})();
---

<a
  href={rawHref || undefined}
  target={computedTarget}
  rel={computedRel}
  aria-current={computedAriaCurrent}
  data-astro-prefetch={computedPrefetch}
  class:list={[
    'anchor',
    variant && variant !== 'default' && `variant-${variant}`,
    action && `action-${action}`,
    size && `size-${size}`,
    wide && `wide-${wide}`,
    label && `label-${label}`,
    isCurrentPage && 'is-active',
    className,
  ]}
  {...props}
><slot /></a>

<style>
  @layer components {
    :is(a, a[role="button"]).anchor {
      /* Component-scoped token aliases with safe fallbacks for Variables / Opal DS */
      --_anchor-fg: var(--color-text-primary, var(--label-primary, currentColor));
      --_anchor-fg-muted: var(--color-text-secondary, var(--label-tertiary, currentColor));
      --_anchor-fg-accent: var(--color-text-accent, var(--accent, oklch(0.62 0.19 25)));
      --_anchor-fg-inverse: var(--color-text-inverse, var(--button-primary-text, oklch(0.985 0 0)));
      --_anchor-bg-surface: var(--fill-tertiary, oklch(0.57 0.01 285 / 0.12));
      --_anchor-bg-hover: oklch(0.57 0.01 285 / 0.18);
      --_anchor-bg-cta: var(--button-primary-background, var(--color-card-dark, oklch(0.2 0 271)));
      --_anchor-bg-cta-hover: var(--button-primary-hover-background, var(--_anchor-fg-accent));
      --_anchor-border: var(--color-border-card, var(--fill-border, oklch(0.57 0.01 285 / 0.2)));
      --_anchor-ring: var(--focus, var(--ring, var(--_anchor-fg-accent)));
      --_anchor-duration: var(--duration-micro-x2, 160ms);
      --_anchor-ease: var(--easing-ease-out, cubic-bezier(0, 0, 0.4, 1));

      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      position: relative;
      width: fit-content;
      height: fit-content;
      font-family: var(--font-family-sans, inherit);
      font-weight: var(--font-weight-regular, 400);
      font-feature-settings: "zero", "tnum";
      font-variant-numeric: tabular-nums;
      letter-spacing: var(--font-tracking-common, -0.01em);
      text-align: center;
      text-decoration: none;
      color: var(--_anchor-fg);
      fill: currentColor;
      cursor: pointer;
      pointer-events: auto;
      user-select: none;
      touch-action: manipulation;
      filter: none;
      opacity: 1;
      backface-visibility: hidden;
      -webkit-font-smoothing: antialiased;
      transition:
        background-color var(--_anchor-duration) var(--_anchor-ease),
        color var(--_anchor-duration) var(--_anchor-ease),
        border-color var(--_anchor-duration) var(--_anchor-ease),
        opacity var(--_anchor-duration) var(--_anchor-ease),
        transform var(--_anchor-duration) var(--_anchor-ease);

      /* Active / Current route state */
      &:is([aria-current="page"], .is-active) {
        font-weight: var(--font-weight-semibold, 600);
        color: var(--_anchor-fg-accent);
      }

      /* Keyboard accessibility */
      &:focus-visible {
        outline: 2px solid var(--_anchor-ring);
        outline-offset: 2px;
      }

      /* Disabled / empty href guard */
      &:is(:not([href]), [aria-disabled="true"]) {
        cursor: not-allowed;
        pointer-events: none;
        opacity: 0.5;
      }

      /* Semantic Actions */
      &.action-default {
        color: var(--_anchor-fg);

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--_anchor-fg-accent);
          }
        }
      }

      &.action-neutral {
        color: var(--_anchor-fg-muted);

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--_anchor-fg);
          }
        }
      }

      &.action-cta {
        padding-block: 0.625rem;
        padding-inline: 1.25rem;
        border-radius: var(--radius-large, 32px);
        background-color: var(--_anchor-bg-cta);
        color: var(--_anchor-fg-inverse);
        font-weight: var(--font-weight-medium, 500);

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            background-color: var(--_anchor-bg-cta-hover);
            color: var(--_anchor-fg-inverse);
          }
        }

        &:focus-visible {
          outline: 2px solid var(--_anchor-ring);
          outline-offset: 3px;
        }
      }

      &.action-danger {
        color: var(--danger-onbackground, oklch(0.55 0.22 27));

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            opacity: 0.85;
          }
        }
      }

      /* Structural Variants */
      &.variant-platted {
        border: 1px solid var(--_anchor-border);
        border-radius: var(--radius-large, 32px);
        background-color: var(--_anchor-bg-surface);
        backdrop-filter: blur(20px);

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            background-color: var(--_anchor-bg-hover);
            transform: scale(1.02);
          }
        }

        &:active {
          transform: scale(0.99);
        }
      }

      &.variant-platterless {
        border-radius: var(--radius-default, 8px);
        background-color: transparent;

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            background-color: var(--_anchor-bg-surface);
          }
        }
      }

      &.variant-underline {
        text-decoration-line: underline;
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.2em;
      }

      /* Sizes & Label Presets */
      &.size-small {
        font-size: var(--font-size-12, 0.75rem);
        gap: 3px;

        &.label-text-and-icon,
        &.label-text-only {
          padding-block: 5px;
          padding-inline: 12px;
        }

        &.label-icon-only {
          padding: 6px;
          border-radius: 50%;
          aspect-ratio: 1;
        }

        & :global(svg) {
          width: 12px;
          height: 12px;
          flex-shrink: 0;
        }
      }

      &.size-medium {
        font-size: var(--font-size-14, 0.875rem);
        gap: 5px;

        &.label-text-and-icon,
        &.label-text-only {
          padding-block: 10px;
          padding-inline: 14px;
        }

        &.label-icon-only {
          padding: 10px;
          border-radius: 50%;
          aspect-ratio: 1;
        }

        & :global(svg) {
          width: 16px;
          height: 16px;
          flex-shrink: 0;
        }
      }

      &.size-large {
        font-size: var(--font-size-16, 1rem);
        gap: 6px;

        &.label-text-and-icon,
        &.label-text-only {
          padding-block: 16px;
          padding-inline: 28px;
        }

        &.label-icon-only {
          padding: 16px;
          border-radius: 50%;
          aspect-ratio: 1;
        }

        & :global(svg) {
          width: 24px;
          height: 24px;
          flex-shrink: 0;
        }
      }

      /* Width Modifiers */
      &.wide-fit {
        width: fit-content;
      }

      &.wide-fill {
        width: 100%;
      }

      &.wide-auto {
        width: auto;
      }

      /* Button role treatment */
      &[role="button"] {
        border-radius: var(--radius-large, 32px);
      }

      @media (prefers-reduced-motion: reduce) {
        transition: none;

        &:hover,
        &:active {
          transform: none !important;
        }
      }
    }
  }
</style>