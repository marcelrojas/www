---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  action?: 'neutral' | 'cta';
  size?: 'small' | 'medium' | 'large';
}

const {
  href,
  target,
  rel,
  'aria-current': ariaCurrentProp,
  class: className,
  action,
  size,
  ...props
} = Astro.props;

const isHash = href.startsWith('#');
const isInternal = href.startsWith('/');
const isExternal = href.startsWith('http://') || href.startsWith('https://') || href.startsWith('//');

let isCurrentlyActive = forceActive;

if (isCurrentlyActive === undefined && href && !isHash && !isExternal) {
  try {
    const targetUrl = new URL(href, Astro.url);
    const targetPath = targetUrl.pathname.replace(/\/$/, '');
    const currentPath = Astro.url.pathname.replace(/\/$/, '');

    isCurrentlyActive =
      targetPath === currentPath ||
      (targetPath !== '' && currentPath.startsWith(`${targetPath}/`));
  } catch {
    isCurrentlyActive = false;
  }
} else if (isCurrentlyActive === undefined) {
  isCurrentlyActive = false;
}

const computedTarget = target ?? (isExternal ? '_blank' : undefined);
const computedRel = rel ?? (isExternal ? 'noopener noreferrer' : undefined);
const computedAriaCurrent = ariaCurrentProp ?? (isCurrentlyActive ? 'page' : undefined);
const prefetch = !isExternal && !isHash ? 'viewport' : undefined;

const classes = [
  className,
  `action-${action}`,
  `size-${size}`,
].join(' ');
---

<a
  href={href}
  target={computedTarget}
  rel={computedRel}
  aria-current={computedAriaCurrent}
  class={classes}
  data-astro-prefetch={isExternal ? 'false' : 'viewport'}
  {...props}
><slot /></a>

<style is:global>
  @layer component {
    :is(a, a[role="button"]) {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      position: relative;
      width: fit-content;
      height: fit-content;
      font-feature-settings: "zero", "tnum";
      font-variant-numeric: tabular-nums;
      letter-spacing: var(--font-tracking-wide);
      text-align: center;
      white-space: pre;
      will-change: background-color, color, opacity;
      transition: background-color 0.15s linear, color 0.15s linear, opacity 0.15s linear;

      &[aria-current="page"] {
        font-weight: var(--font-weight-semibold);
        color: var(--accent);
      }

      &:active {

      }

      &[aria-pressed="true"] {

      }

      &.action-neutral {
        color: var(--);
        fill: var(--);

        &:is(:focus, :focus-visible) {
          color: var(--brand-red);
          outline: 2px solid var(--brand-red);
          outline-offset: -2px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--brand-red);
          }
        }
      }

      &.action-cta {
        color: var(--);
        fill: var(--);

        &:focus, &:focus-visible {
          box-shadow: rgba(8, 40, 69, 0.35) 0px 0px 0px 1px inset;
          outline: rgb(255, 255, 255) solid 2px;
          outline-offset: -4px;
        }

        @media (hover: hover) {
          &:hover:not([aria-current="page"]) {
            color: var(--);
          }
        }
      }

      &.size-small {
        font-size: var(--font-size-12);
        gap: 3px;

        & svg {
          width: 8px;
          height: 8px;
        }
      }

      &.size-medium {
        font-size: var(--font-size-14);
        gap: 5px;

        & svg {
          width: 16px;
          height: 16px;
        }
      }

      &.size-large {
        font-size: var(--font-size-14);
        gap: 6px;

        & svg {
          width: 32px;
          height: 32px;
        }
      }
    }
  }
</style>