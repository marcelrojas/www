{
  "$schema": "https://tr.designtokens.org/format/",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": "oklab(0.995 0.000 0.000)" },
        "50": { "$value": "oklab(0.975 -0.001 0.002)" },
        "100": { "$value": "oklab(0.940 -0.002 0.002)" },
        "200": { "$value": "oklab(0.860 -0.003 -0.005)" },
        "300": { "$value": "oklab(0.760 -0.004 -0.008)" },
        "600": { "$value": "oklab(0.360 -0.004 -0.008)" },
        "800": { "$value": "oklab(0.220 -0.004 -0.010)" },
        "900": { "$value": "oklab(0.160 -0.003 -0.008)" },
        "950": { "$value": "oklab(0.125 -0.004 -0.012)" }
      },
      "accent": {
        "blue-light": { "$value": "oklab(0.820 -0.045 -0.115)" },
        "blue-dark": { "$value": "oklab(0.410 -0.045 -0.145)" },
        "danger-light": { "$value": "oklab(0.780 0.140 0.060)" },
        "danger-dark": { "$value": "oklab(0.440 0.165 0.075)" }
      }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "InterVariable",
          "Inter",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "GeistMono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "dimension": {
      "$type": "dimension",
      "space": {
        "1": { "$value": "0.25rem" },
        "2": { "$value": "0.5rem" },
        "3": { "$value": "0.75rem" },
        "4": { "$value": "1rem" },
        "6": { "$value": "1.5rem" },
        "8": { "$value": "2rem" },
        "12": { "$value": "3rem" }
      },
      "radius": {
        "sm": { "$value": "0.25rem" },
        "md": { "$value": "0.5rem" },
        "pill": { "$value": "9999px" }
      }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "surface": {
        "primary": {
          "$value": "{primitive.color.neutral.50}",
          "$description": "Primary page surface (light theme)"
        },
        "elevated": {
          "$value": "{primitive.color.neutral.0}",
          "$description": "Elevated card and dialog surface"
        },
        "subtle": {
          "$value": "{primitive.color.neutral.100}",
          "$description": "Subtle recessed surface"
        },
        "inverse": {
          "$value": "{primitive.color.neutral.950}",
          "$description": "High-contrast dark surface"
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.neutral.900}",
          "$description": "WCAG AAA primary body copy (>15:1 on surface.primary)"
        },
        "secondary": {
          "$value": "{primitive.color.neutral.600}",
          "$description": "WCAG AAA secondary copy (>9:1 on surface.primary)"
        },
        "accent": {
          "$value": "{primitive.color.accent.blue-dark}",
          "$description": "WCAG AAA interactive accent (>7.5:1 on surface.primary)"
        },
        "inverse": {
          "$value": "{primitive.color.neutral.0}",
          "$description": "WCAG AAA text on dark surfaces"
        },
        "danger": {
          "$value": "{primitive.color.accent.danger-dark}",
          "$description": "WCAG AAA destructive action text"
        }
      },
      "border": {
        "subtle": { "$value": "{primitive.color.neutral.200}" },
        "strong": { "$value": "{primitive.color.neutral.300}" }
      }
    },
    "dark": {
      "$type": "color",
      "surface": {
        "primary": { "$value": "{primitive.color.neutral.950}" },
        "elevated": { "$value": "{primitive.color.neutral.900}" },
        "subtle": { "$value": "{primitive.color.neutral.800}" }
      },
      "text": {
        "primary": { "$value": "{primitive.color.neutral.0}" },
        "secondary": { "$value": "{primitive.color.neutral.200}" },
        "accent": { "$value": "{primitive.color.accent.blue-light}" },
        "danger": { "$value": "{primitive.color.accent.danger-light}" }
      },
      "border": {
        "subtle": { "$value": "{primitive.color.neutral.800}" },
        "strong": { "$value": "{primitive.color.neutral.600}" }
      }
    }
  }
}
