---
import type { CollectionEntry } from 'astro:content';
import Head from '@components/structure/Head.astro';
import SkipLinks from '@components/structure/SkipLinks.astro';
import Header from '@components/structure/Header.astro';
import ArticleFooter from '@components/structure/ArticleFooter.astro';
import Footer from '@components/structure/Footer.astro';
import FormattedDate from '@components/FormattedDate.astro';
import { Image } from 'astro:assets';

export interface TransitionAnimation {
  name: string;
  delay?: number | string;
  duration?: number | string;
  easing?: string;
  fillMode?: string;
  direction?: string;
}

export interface TransitionAnimationPair {
  old: TransitionAnimation | TransitionAnimation[];
  new: TransitionAnimation | TransitionAnimation[];
}

export interface TransitionDirectionalAnimations {
  forwards: TransitionAnimationPair;
  backwards: TransitionAnimationPair;
}

type Props = CollectionEntry<'weblog'>['data'];

const { title, description, lang = 'en', pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang={lang} dir="auto">
  <Head title={title} description={description} />
  <body>
    <SkipLinks />
    <Header />

    <main id="main" tabindex="-1">
      <article id="blogpost">
        <picture class="hero-media">
          {heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
        </picture>
        <div class="prose">
          <header>
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <span class="last-updated">
                    Last updated on <FormattedDate date={updatedDate} />
                  </span>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
            {editions.length > 0 && (
              <ul class="editions" aria-label="Available in other languages">
                {editions.map((edition) => (
                  <li>
                    <Anchor href={edition.url} size="small">{edition.lang.toUpperCase()} — {edition.title}</Anchor>
                    {edition.translatedBy && <span class="translator">· trad. {edition.translatedBy}</span>}
                  </li>
                ))}
              </ul>
            )}
          </header>
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  @layer layout {
    article#blogpost {
      width: calc(100% - 2em);
      max-width: 100%;


    }

    .hero-media {
      width: 100%;

      & img {
        display: block
      }
    }

    .prose {
      width: 720px;
      max-width: calc(100% - 2em);
      margin: auto;
      padding: 1em
    }

    .header {
      margin-bottom: 1em;
      padding: 1em 0;
      text-align: center;
      line-height: 1
    }

    .date {
      margin-bottom: 0.5em
    }

    .last-updated {
      font-style: italic
    }

    p {
      margin-bottom: 1em
    }

    .prose p {
      margin-bottom: 2em
    }
  }

  section {
    page-break-after: always;
    break-after: page
  }

  @page {
    size: landscape;
    margin: 2cm
  }

  @media print {
    button {
      display: none
    }
  }
</style>

<style>
  @layer components {
    article {
      display: grid;
      gap: 2.5rem;
      max-inline-size: 720px;
      padding: 2rem;
      background-color: var(--color-canvas);
      color: var(--color-surface);
      letter-spacing: var(--type-tracking);
      line-height: var(--type-leading);
      font-weight: var(--type-weight);
    }

    /* Tipografía Estructurada (Naming Structure) */
    .naming-structure {
      display: grid;
      gap: 0.5rem;
      text-align: start;

      .brand-tag {
        font-size: var(--scale-3);
        text-transform: capitalize;
      }

      .title-en {
        font-size: clamp(var(--scale-3), 5vw, var(--scale-4));
        text-wrap: balance;
      }

      .title-ja, .spec-inline {
        font-family: var(--font-cjk);
        /* Reducción proporcional óptica del 85% para caracteres japoneses */
        font-size: calc(var(--scale-3) * 0.85);
      }

      .spec-inline {
        font-size: calc(var(--scale-3) * 0.95);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
    }

    /* Bloque de Información Cuadriculado (Information Block Structure) */
    .info-block {
      border: var(--rule-solid);
      display: grid;
      grid-template-rows: auto auto auto;

      .block-row {
        display: grid;
        border-block-end: var(--rule-solid);
      }

      .id-row {
        grid-template-columns: auto 1fr;
        align-items: center;
        padding: 0.5rem 1rem;
        gap: 1.5rem;

        .article-code {
          font-size: var(--scale-3);
          font-variant-numeric: tabular-nums;
        }

        .meta-data {
          font-size: var(--scale-1);
          text-align: start;
          text-transform: uppercase;
        }
      }

      .pictogram-row {
        grid-template-columns: repeat(4, 1fr);

        .pictogram-cell {
          padding: 0.75rem;
          display: grid;
          place-items: center;
          border-inline-end: var(--rule-solid);

          &:last-child {
            border-inline-end: none;
          }

          svg {
            inline-size: 2rem;
            block-size: 2rem;
          }
        }
      }

      .barcode-area {
        padding: 0.75rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;

        .barcode-graphic {
          block-size: 2rem;
          background: repeating-linear-gradient(
            to right,
            var(--color-surface) 0px,
            var(--color-surface) 2px,
            transparent 2px,
            transparent 4px,
            var(--color-surface) 4px,
            var(--color-surface) 7px,
            transparent 7px,
            transparent 9px
          );
        }

        .barcode-value {
          font-size: var(--scale-1);
          font-variant-numeric: tabular-nums;
          letter-spacing: 0.05em;
        }
      }
    }

    .sr-only {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>